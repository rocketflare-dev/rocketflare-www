---
/**
 * The social card template: `public/og-image.png` is a 1200×630 screenshot of
 * this page in the day theme (CLAUDE.md, "The OG image" — the capture command
 * lives there). Tokens only, so the card re-themes with the palette; the shell
 * (nav, footer, skip link) is hidden and the viewport is pinned to the card.
 *
 * Not in the page registry (it would reach the nav), `noindex`, and listed in
 * SITEMAP_EXCLUDED_PATHS (src/data/pages.ts) so it never enters the sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMark from '../components/LogoMark.astro'

const pills = ['MIT licensed', 'One Worker', 'Agent-first']
---
<BaseLayout
	title="Rocketflare — social card template"
	description="The 1200×630 template public/og-image.png is captured from. Not a page of the site."
	noindex
>
	<div class="og">
		<div class="stars" aria-hidden="true"></div>
		<div class="sun" aria-hidden="true"></div>
		<svg class="clouds" viewBox="0 0 1600 200" preserveAspectRatio="none" aria-hidden="true">
			<g fill="var(--cloud)">
				<path d="M80 150c0-28 22-50 50-50 6 0 12 1 17 3 9-27 34-47 64-47 32 0 59 22 66 52 8-6 17-9 27-9 26 0 47 20 49 46 19 2 34 18 34 38v17H40v-12c0-19 17-36 40-38z"/>
				<path d="M520 160c0-22 18-40 40-40 5 0 9 1 14 2 7-22 28-38 52-38 26 0 47 18 53 42 6-5 14-7 21-7 21 0 38 16 40 37 15 2 27 14 27 30v14H488v-10c0-16 14-29 32-30z"/>
				<path d="M980 152c0-25 20-45 45-45 5 0 11 1 16 3 8-25 31-43 58-43 29 0 54 20 60 47 7-5 16-8 24-8 24 0 43 18 45 42 17 2 31 16 31 34v16H944v-11c0-17 15-33 36-35z"/>
				<path d="M1380 165c0-19 15-34 34-34 4 0 8 0 12 2 6-19 24-33 45-33 22 0 40 15 45 36 5-4 11-6 18-6 18 0 33 14 34 32 13 1 23 12 23 26v12h-268v-9c0-14 12-25 27-26z"/>
			</g>
		</svg>
		<div class="copy">
			<div class="brand"><LogoMark size={64} /><span>Rocketflare</span></div>
			<h1>Ship the product.<br /><span class="grad">Not the platform.</span></h1>
			<p>A ready-made multi-tenant app for Cloudflare Workers — running in about two minutes.</p>
			<ul class="pills" aria-label="In three words">
				{pills.map((p) => <li>{p}</li>)}
			</ul>
		</div>
	</div>
</BaseLayout>

<style>
	/* Pin the document to the card and drop the site chrome (`body >` outranks
	   BaseLayout's own `nav.site-nav` rule, which is emitted after this one). */
	:global(html), :global(body) { width: 1200px; height: 630px; margin: 0; overflow: hidden; }
	:global(body > nav.site-nav), :global(body > footer), :global(body > .skip-link) { display: none; }
	:global(body > main) { width: 1200px; height: 630px; }

	.og {
		position: relative;
		width: 1200px;
		height: 630px;
		overflow: hidden;
		background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--sky-bottom) 100%);
	}
	.sun {
		position: absolute;
		top: 64px;
		right: 120px;
		width: 150px;
		height: 150px;
		border-radius: 50%;
		background: var(--sun);
		opacity: 0.6;
		filter: blur(2px);
		box-shadow: 0 0 90px 40px var(--sun);
	}
	.stars {
		position: absolute;
		inset: 0;
		background-image:
			radial-gradient(1.6px 1.6px at 12% 18%, var(--star), transparent),
			radial-gradient(1.4px 1.4px at 32% 8%, var(--star), transparent),
			radial-gradient(1.8px 1.8px at 58% 22%, var(--star), transparent),
			radial-gradient(1.3px 1.3px at 74% 12%, var(--star), transparent),
			radial-gradient(1.6px 1.6px at 88% 30%, var(--star), transparent);
	}
	.clouds {
		position: absolute;
		left: -40px;
		bottom: -18px;
		width: 1300px;
		height: 190px;
		opacity: 0.95;
	}
	.copy {
		position: relative;
		z-index: 1;
		padding: 64px 80px 0;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 34px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text-bright);
		margin-bottom: 30px;
	}
	h1 {
		font-size: 82px;
		line-height: 1.02;
		letter-spacing: -0.03em;
		margin: 0 0 22px;
	}
	.grad {
		background: linear-gradient(100deg, var(--orange), var(--red) 40%, var(--blue-bright));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	p {
		font-size: 30px;
		line-height: 1.3;
		max-width: 26ch;
		color: var(--text);
		margin: 0 0 28px;
	}
	.pills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 12px;
	}
	.pills li {
		font-family: var(--mono);
		font-size: 19px;
		padding: 8px 20px;
		border-radius: 999px;
		color: var(--text-bright);
		background: color-mix(in srgb, var(--cloud) 75%, transparent);
		border: 1px solid var(--border-bright);
	}
</style>
