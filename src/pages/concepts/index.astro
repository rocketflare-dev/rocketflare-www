---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ConceptIcon from '../../components/ConceptIcon.astro'
import CloudDivider from '../../components/CloudDivider.astro'
import { CONCEPTS } from '../../data/concepts'
import { CONCEPTS_URL } from '../../data/site'

const title = 'Concepts — how a multi-tenant SaaS on Cloudflare Workers fits together'
const description =
	'Thirteen concepts, one page each: tenancy, auth, the API shell, Postgres, background work, storage, the UI, analytics, the AI agent layer, deployment, the CLI and shared contracts — what each does in Rocketflare, the invariant it protects, and the decision behind it.'
---
<BaseLayout title={title} description={description}>
	<header class="index-hero">
		<div class="wrap">
			<span class="eyebrow">Concepts</span>
			<h1>What it is, and why it is that way</h1>
			<p class="lede">
				Every subsystem in the kit gets a page: what it does today, the invariant it protects, and
				the reasoning that produced it. Read them in order for the tour, or jump to the one you are
				about to change. The full reference lives in
				<a href={CONCEPTS_URL} target="_blank" rel="noopener">docs/CONCEPTS.md</a> in the repo.
			</p>
		</div>
		<CloudDivider fill="var(--bg)" />
	</header>

	<section class="index-grid-wrap">
		<div class="wrap">
			<div class="index-grid">
				{CONCEPTS.map((c) => (
					<a class={`ccard tone-${c.tone} reveal`} href={`/concepts/${c.slug}/`}>
						<span class="ccard-num">{c.num}</span>
						<span class="chip"><ConceptIcon name={c.icon} /></span>
						<h2>{c.title}</h2>
						<p>{c.blurb}</p>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.index-hero {
		position: relative;
		padding: 4rem 0 7rem;
		background: linear-gradient(180deg, var(--sky-top), var(--sky-mid) 60%, var(--bg));
	}
	.index-hero h1 { max-width: 16ch; }
	.lede { max-width: 62ch; font-size: 1.1rem; color: var(--text-muted); }

	.index-grid-wrap { padding: 0 0 5rem; background: var(--bg); }
	.index-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.4rem;
	}
	.ccard {
		position: relative;
		background: var(--card);
		border: 1px solid var(--border);
		border-top: 4px solid var(--accent);
		border-radius: 18px;
		padding: 1.6rem;
		color: var(--text);
		box-shadow: var(--shadow-sm);
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, border-color 0.25s ease;
	}
	.ccard:hover {
		text-decoration: none;
		transform: translateY(-6px);
		box-shadow: var(--shadow);
		border-color: var(--accent);
	}
	.ccard h2 { font-size: 1.15rem; margin: 0 0 0.4rem; }
	.ccard p { margin: 0; font-size: 0.93rem; color: var(--text-muted); }
	.ccard-num {
		position: absolute;
		top: 1.1rem;
		right: 1.3rem;
		font-family: var(--mono);
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--accent);
		opacity: 0.22;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 13px;
		background: var(--tint);
		color: var(--accent);
		margin-bottom: 0.9rem;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.chip :global(svg) { width: 22px; height: 22px; }
	.ccard:hover .chip { transform: rotate(-8deg) scale(1.08); }

	.tone-blue   { --accent: var(--blue-bright); --tint: var(--tint-blue); }
	.tone-purple { --accent: var(--purple);      --tint: var(--tint-purple); }
	.tone-orange { --accent: var(--orange);      --tint: var(--tint-orange); }
	.tone-cyan   { --accent: var(--cyan);        --tint: var(--tint-cyan); }
	.tone-red    { --accent: var(--red);         --tint: var(--tint-red); }
	.tone-green  { --accent: var(--green);       --tint: var(--tint-green); }
	.tone-yellow { --accent: var(--yellow);      --tint: var(--tint-yellow); }
</style>
