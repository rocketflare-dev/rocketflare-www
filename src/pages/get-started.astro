---
/**
 * Get started: three ways from a clone to a browser you are signed in to
 * (ask your agent · one command · by hand), what the bootstrap did, how to
 * deploy with /rf-provision, the honest notes, and the rename that makes the
 * kit yours. Every kit literal comes from src/data/get-started.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHead from '../components/SectionHead.astro'
import Callout from '../components/Callout.astro'
import Steps from '../components/Steps.astro'
import Terminal from '../components/Terminal.astro'
import AgentChat from '../components/AgentChat.astro'
import Tabs from '../components/Tabs.astro'
import Screenshot from '../components/Screenshot.astro'
import ConceptIcon from '../components/ConceptIcon.astro'
import { pageByPath } from '../data/pages'
import {
	ADAPTING_URL,
	CLAUDE_CODE_URL,
	CLOUDFLARE_TOKENS_URL,
	INSTALL_SH_SOURCE_URL,
	NEON_API_KEYS_URL,
	RESEND_API_KEYS_URL,
	SETUP_PART1_URL,
	SETUP_PART3_URL,
} from '../data/site'
import {
	AGENT_CLI_CMD,
	AGENT_NAME,
	API_URL,
	APP_URL,
	BOOTSTRAP_CMD,
	BOOTSTRAP_EXPECT,
	BOOTSTRAP_FLAGS_SHORT,
	BOOTSTRAP_READY_LINE,
	BOOTSTRAP_RERUN_CMD,
	BOOTSTRAP_STEPS,
	bootstrapLine,
	BY_HAND_STEPS,
	CLONE_LINES,
	DEMO,
	DEPLOY_ACCOUNTS,
	DEPLOY_VARS,
	PROVISION_TOKENS_CMD,
	PROVISION_ENV_FILE,
	INSTALL_CMD,
	PROVISION_CMD,
	PROVISION_PHASES,
	PROVISION_SKIP_EMAIL_FLAG,
	PROVISION_VERIFY_WORD,
	SKILLS,
	KIT_MANIFEST_FILE,
	UPGRADE_CMD,
	UPGRADE_NOTES_DIR,
} from '../data/get-started'

import homeLight from '../assets/screens/home.light.png'
import homeDark from '../assets/screens/home.dark.png'

const page = pageByPath('/get-started/')
if (!page) throw new Error('Page not in the registry: /get-started/')

const description =
	'Run Rocketflare on your laptop in about two minutes — ask your coding agent, run one script, or follow the steps by hand — then deploy it to Cloudflare with one command. A Mac or Linux machine, Docker, and a free Cloudflare login are the whole list.'

/** Steps bodies are inline HTML; the commands need their ampersands escaped. */
const esc = (s: string) => s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')

const tokenUrls: Record<string, string> = {
	Cloudflare: CLOUDFLARE_TOKENS_URL,
	Neon: NEON_API_KEYS_URL,
	Resend: RESEND_API_KEYS_URL,
}

const bootstrapTail = [
	...BOOTSTRAP_STEPS.map((_, i) => ({ out: bootstrapLine(i), ok: true })),
	{ out: BOOTSTRAP_READY_LINE, ok: true },
]

const handSteps = BY_HAND_STEPS.map((s) => ({
	title: s.title,
	body: [
		...s.cmds.map((c) => `<code>${esc(c)}</code>`),
		s.note ? `<span class="note">${esc(s.note)}</span>` : '',
		`<span class="verify"><strong>Verify:</strong> ${esc(s.verify)}</span>`,
	]
		.filter(Boolean)
		.join('<br />'),
}))

const setupTurns = [
	{ who: 'you' as const, text: SKILLS.setup },
	{
		who: 'agent' as const,
		text: 'Running the first-run script and explaining each line as it lands. It will fix anything missing — Docker, Node 24, pnpm — and ask whether to log in to Cloudflare or stay offline.',
		checks: BOOTSTRAP_STEPS.map((s) => s.plain),
	},
	{
		who: 'agent' as const,
		text: `Opened ${APP_URL}. You're signed in as ${DEMO.ownerName}, owner of ${DEMO.org}. Try Chat, Agents, Knowledge or Analytics.`,
	},
]

/** The left-hand index: one entry per section of the page. */
const SECTIONS = [
	{ id: 'ways', label: 'Three ways in' },
	{ id: 'happened', label: 'What just happened' },
	{ id: 'deploy', label: 'Deploy it' },
	{ id: 'honest', label: 'Honest notes' },
	{ id: 'yours', label: 'Make it yours' },
	{ id: 'current', label: 'Stay current' },
]

const provisionTurns = [
	{ who: 'you' as const, text: SKILLS.provision },
	{
		who: 'agent' as const,
		text: `Tokens found in ${PROVISION_ENV_FILE}. Running the phases in order — each one ends in a ${PROVISION_VERIFY_WORD} line I'll show you, and I stop at the first that fails:`,
		checks: PROVISION_PHASES.map((p) => `${p.name} — ${p.plain}`),
	},
	{
		who: 'agent' as const,
		text: `${PROVISION_VERIFY_WORD} staging answers at its /api/health with status ok, and the sending domain is verified. Publish a GitHub release when you want production.`,
	},
]
---

<BaseLayout title={page.title} description={description} noindex={!page.ready}>
	<!-- ========================================================= intro -->
	<section class="intro page-hero bg-sky">
		<div class="wrap">
			<div class="hero-copy">
			<span class="eyebrow">From a clone to signed in</span>
			<h1>Get started</h1>
			<p class="lede">
				You need a Mac or a Linux machine, Docker Desktop running, and a free Cloudflare login the
				first time it starts — that's the list. Nothing to sign up for beyond that, no keys to
				paste. Pick whichever of the three paths below suits you; they all end in your browser,
				signed in as the owner of a demo organisation.
			</p>
			</div>
		</div>
	</section>

	<div class="wrap gs-body">
		<aside class="side">
			<p class="side-head">On this page</p>
			<nav aria-label="Sections of this page">
				{SECTIONS.map((sec, i) => (
					<a href={`#${sec.id}`} class="side-link" data-section={sec.id}>
						<span class="side-num">{String(i + 1).padStart(2, '0')}</span> {sec.label}
					</a>
				))}
			</nav>
		</aside>

		<div class="gs-main">
	<!-- ===================================================== three ways -->
	<section class="ways" id="ways">
		<SectionHead
			align="left"
			title="Three ways in"
			lede="Run one script, ask your coding agent, or do each step yourself. Same result, your choice of company."
		/>
		<Tabs
			tabs={[
				{ id: 'one-command', label: 'One command' },
				{ id: 'agent', label: 'Ask your agent' },
				{ id: 'by-hand', label: 'By hand' },
			]}
			default="one-command"
		>
			<Fragment slot="agent">
				<p class="step-line">
					<span class="num">1</span>
					<span>Install <a href={CLAUDE_CODE_URL} target="_blank" rel="noopener">Claude Code</a>, clone the
					repository and open the folder in it.</span>
				</p>
				<Terminal title="zsh" lines={[...CLONE_LINES, { cmd: AGENT_CLI_CMD }]} />
				<p class="step-line">
					<span class="num">2</span>
					<span>Type <code>{SKILLS.setup}</code> — or just ask it to set the project up. The skill runs
					the same script as the other two paths and narrates it.</span>
				</p>
				<AgentChat agent={AGENT_NAME} turns={setupTurns} />
				<p class="after">
					Then <code>{SKILLS.adapt}</code> renames everything — package names, the Worker, the
					database, the command-line tool, the theme — and <code>{SKILLS.provision}</code> deploys
					it (<a href="#deploy">below</a>). <code>{SKILLS.upgrade}</code> ports later kit releases
					in, and <code>{SKILLS.plugin}</code> installs, upgrades or removes a
					<a href="/concepts/plugins/">plugin</a>.
				</p>
			</Fragment>

			<Fragment slot="one-command">
				<p>
					The installer clones, detaches the kit's history so the copy is yours from the first
					commit, and runs the bootstrap — one line per step, then your browser opens signed in.
					<a href={INSTALL_SH_SOURCE_URL} target="_blank" rel="noopener">Read it first</a> — it is
					short.
				</p>
				<Terminal
					title="zsh"
					lines={[{ cmd: INSTALL_CMD }, ...bootstrapTail]}
					expect={BOOTSTRAP_EXPECT}
				/>
				<h4>Or clone it yourself</h4>
				<p>
					The same thing in three commands, if you would rather see each one. The second is what
					makes the copy yours: the kit is a template, not an upstream, so its history goes and
					yours starts at commit one. Re-running the bootstrap after a fix is always safe
					(<code>{BOOTSTRAP_RERUN_CMD}</code> once dependencies exist).
				</p>
				<Terminal
					title="zsh"
					lines={[...CLONE_LINES, { cmd: BOOTSTRAP_CMD }]}
					expect={BOOTSTRAP_EXPECT}
				/>
				<table class="flags">
					<caption>Flags worth knowing (<code>--help</code> lists them all)</caption>
					<tbody>
						{BOOTSTRAP_FLAGS_SHORT.map((f) => (
							<tr>
								<th scope="row"><code>{f.flag}</code></th>
								<td>{f.what}</td>
							</tr>
						))}
					</tbody>
				</table>
			</Fragment>

			<Fragment slot="by-hand">
				<p>
					The bootstrap, unrolled. This is
					<a href={SETUP_PART1_URL} target="_blank" rel="noopener">SETUP.md Part 1</a>; every step
					ends in the line that proves it worked, and the next step waits until you have seen it.
				</p>
				<Terminal title="zsh" lines={CLONE_LINES} />
				<div class="hand">
					<Steps direction="column" steps={handSteps} />
				</div>
			</Fragment>
		</Tabs>
	</section>

	<!-- ============================================== what just happened -->
	<section class="happened" id="happened">
		<SectionHead
			align="left"
			title="What just happened"
			lede="Whichever path you took, this is now true on your machine."
		/>
		<Steps
			direction="row"
			numbered={false}
			steps={[
				{ title: 'Postgres in Docker', body: 'One container on port 5432, with the vector extension for search.' },
				{ title: 'Schema migrated', body: 'Every table, with the row-level policies in place but not yet enforced.' },
				{ title: 'Demo organisation seeded', body: `${DEMO.org}: people with roles, documents, chats and a dashboard.` },
				{ title: 'App on :3000, API on :3001', body: 'The interface and the Worker, each reloading as you edit.' },
				{ title: 'You, signed in as the owner', body: `${DEMO.ownerName} (${DEMO.ownerEmail}) — the dev quick-login, which does not exist when deployed.` },
			]}
		/>
		<Screenshot
			light={homeLight}
			dark={homeDark}
			alt={`Home, signed in as ${DEMO.ownerName}, owner of ${DEMO.org}, with quick links and recent activity`}
			url="localhost:3000"
			caption="Home, the moment the bootstrap finishes."
			width={960}
		/>
	</section>

	<!-- ========================================================= deploy -->
	<section class="deploy" id="deploy">
		<SectionHead
			audience="builder"
			align="left"
			title="Deploy it"
			lede="Three accounts you create yourself, one domain, one command. The kit can create projects, databases and DNS records inside your accounts — it cannot create the accounts."
		/>
		<h3>Before anything: three accounts</h3>
		<ol class="accounts">
			{DEPLOY_ACCOUNTS.map((a, i) => (
				<li>
					<span class="num">{i + 1}</span>
					<div class="acct-body">
						<div class="acct-head">
							<strong>{a.name}</strong>
							<span class="role">{a.role}{a.plan && <> · {a.plan}</>}</span>
						</div>
						<p class="first">{a.first}</p>
						<p class="mint">
							Read by the kit as <span class="vars">{a.envVars.map((v) => <code>{v}</code>)}</span>{a.also && <> — {a.also}</>}
						</p>
					</div>
					<ul class="acct-links" aria-label={`${a.name} links`}>
						<li><a class="acct-primary" href={a.signupUrl} target="_blank" rel="noopener">Create a {a.name} account ↗</a></li>
						{(a.links ?? []).map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a></li>)}
						<li><a href={tokenUrls[a.name]} target="_blank" rel="noopener">Mint {a.token} ↗</a></li>
					</ul>
				</li>
			))}
		</ol>
		<h3>Then hand the tokens to the kit — once, in your own terminal</h3>
		<p>
			<code>{PROVISION_TOKENS_CMD}</code> asks for each token with hidden input, checks it against
			the service, and writes <code>{PROVISION_ENV_FILE}</code> (git-ignored, readable only by you).
			Nothing is pasted into a chat. In CI, export the same variables instead — they take precedence.
		</p>
		<Terminal
			title="your terminal"
			lines={[
				{ cmd: PROVISION_TOKENS_CMD },
				...DEPLOY_VARS.map((v) => ({ out: `${v.padEnd(22)} paste (hidden) → checked`, ok: true })),
			]}
			expect={`Writes ${PROVISION_ENV_FILE}; then /provision, or ${PROVISION_CMD}`}
		/>
		<AgentChat agent={AGENT_NAME} turns={provisionTurns} />
		<p class="after">
			Without an agent, the same thing is <code>{PROVISION_CMD}</code> (add
			<code>{PROVISION_SKIP_EMAIL_FLAG}</code> when there is no Resend account). It creates the
			Neon project and its staging branch; Hyperdrive, KV, the queue and the R2 bucket; writes the
			ids into both wrangler files; runs the migrations; sets the GitHub environment secrets;
			deploys staging; sets the Worker secrets over stdin; and creates and verifies the Resend
			domain with its DNS records on Cloudflare. The step-by-step manual path is
			<a href={SETUP_PART3_URL} target="_blank" rel="noopener">SETUP.md Part 3</a>.
		</p>
	</section>

	<!-- =================================================== honest notes -->
	<section class="honest" id="honest">
		<SectionHead
			align="left"
			title="Honest notes"
			lede="Four things that are true and worth knowing before you start."
		/>
		<div class="notes">
			<Callout tone="blue" title="macOS or Linux">
				<svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 18v3"/></svg>
				<p>The bootstrap is a shell script and refuses other systems. Windows works through WSL2, but that path is untested.</p>
			</Callout>
			<Callout tone="green" title="Docker must be running">
				<ConceptIcon slot="icon" name="database" />
				<p>Postgres runs in a container. Docker Desktop, or colima on a Mac (<code>brew install colima docker &amp;&amp; colima start</code>), has to be up before the database step.</p>
			</Callout>
			<Callout tone="orange" title="The Cloudflare login, and what it costs">
				<ConceptIcon slot="icon" name="cloud" />
				<p>The built-in AI runs on Workers AI, which always calls Cloudflare, so the first <code>pnpm dev</code> asks for a login — a free account is enough. Every AI call is billed to that account: 10 000 free neurons a day, then metered. Start with <code>--offline</code> and it is never asked for; chat, agents and search then wait for a key of your own.</p>
			</Callout>
			<Callout tone="yellow" title="Deploying needs Workers Paid">
				<ConceptIcon slot="icon" name="rocket" />
				<p>Running it on your laptop costs nothing. Deploying needs the paid Workers plan, because the database connection pool (Hyperdrive) and the workflows the agents run on are paid features.</p>
			</Callout>
		</div>
	</section>

	<!-- ================================================= make it yours -->
	<section class="yours" id="yours">
		<h2>Then make it yours</h2>
		<p class="measure">
			A fresh copy is still called Rocketflare in a few dozen places — package names, the Worker,
			the database, the command-line tool, the theme colours, the email sender.
			<code>{SKILLS.adapt}</code> renames the mechanical ones in one reviewable commit and walks
			you through the handful that need a person. The same list, for doing it by hand, is
			<a href={ADAPTING_URL} target="_blank" rel="noopener">docs/ADAPTING.md</a>.
		</p>
		<p class="measure">
			After that, the kit is your app. The command-line tool speaks to it at
			<code>{API_URL}</code> while you develop and at your own host once deployed.
		</p>
	</section>

	<!-- ================================================= stay current -->
	<section class="current" id="current">
		<h2>Staying current</h2>
		<p class="measure">
			Your copy has no upstream — you will rename, delete and rewrite freely, and you never merge
			from us. That does not mean you are stuck on the version you copied. A file at the root,
			<code>{KIT_MANIFEST_FILE}</code>, records which release you came from, the names you renamed
			to, and which of the kit's replaceable parts you still have. Run
			<code>{SKILLS.upgrade}</code> (or <code>{UPGRADE_CMD}</code>) and it fetches the kit,
			rewrites its changes into your names, and hands you the ones that still apply.
		</p>
		<p class="measure">
			The part that makes this safe is what it refuses to do. Delete the example agent, the
			example dashboard or the command-line commands you did not want — or add a
			<a href="/concepts/plugins/">plugin</a>, which is a repository copied in rather than a
			package installed — and an upgrade will never bring back what you removed, nor touch a file
			a plugin owns. It leaves your database migrations, your Cloudflare configuration and your
			version number alone, and tells you what it left for you. Every release ships a note in
			<code>{UPGRADE_NOTES_DIR}</code> saying what changed and how to port it; the
			<a href="/changelog/">changelog</a> is the list.
		</p>
		<p class="measure">
			One thing to know: keep <code>{KIT_MANIFEST_FILE}</code>. Deleting it is the only way to
			lose the upgrade path.
		</p>
	</section>
		</div>
	</div>
</BaseLayout>

<style>
	/* ----------------------------------------------------------- intro -- */
	/* Width, h1 and lede come from the global .page-hero (BaseLayout). */

	/* ------------------------------------------------------------ body --
	   Two columns with a sticky index, the same shape as the tour and the
	   concept pages: the sections are sized by the column, not by their own
	   container, so the page has one edge and no empty right-hand margin. */
	.gs-body {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}
	.gs-main { min-width: 0; }
	.side { position: sticky; top: 5.5rem; min-width: 0; padding-top: 3.4rem; }
	.side-head {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.7rem;
	}
	/* BaseLayout styles every <nav> as the site header (sticky, centred,
	   padded, bordered) — undo that here; this one is an index. */
	.side nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0;
		position: static;
		padding: 0;
		background: none;
		backdrop-filter: none;
		border: 0;
		border-left: 2px solid var(--border);
	}
	.side-link {
		display: flex;
		gap: 0.5rem;
		padding: 0.34rem 0.9rem;
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--text-muted);
		border-left: 2px solid transparent;
		margin-left: -2px;
		white-space: nowrap;
	}
	.side-link:hover { color: var(--text-bright); text-decoration: none; }
	.side-num { flex: none; font-family: var(--mono); font-size: 0.76rem; padding-top: 0.15em; }
	.side-link.current { color: var(--orange-ink); font-weight: 600; border-left-color: var(--orange); }

	/* One rhythm for every section of the body; a rule separates them
	   instead of the full-width bands the one-column page used. */
	.gs-main > section { padding: 3.4rem 0; }
	.gs-main > section + section { border-top: 1px solid var(--border); }
	.gs-main > section:last-child { padding-bottom: 5rem; }

	/* ------------------------------------------------------ three ways -- */
	.ways h4 { margin: 2.2rem 0 0.4rem; font-size: 1.05rem; }
	.step-line {
		display: flex;
		gap: 0.8rem;
		align-items: flex-start;
		margin: 1.4rem 0 0.6rem;
	}
	.num {
		flex: none;
		display: inline-grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		font-size: 0.85rem;
		font-weight: 800;
		color: var(--on-accent);
		background: linear-gradient(150deg, var(--orange), var(--red));
	}
	.after { margin-top: 1.4rem; color: var(--text-muted); }

	.flags {
		width: 100%;
		border-collapse: collapse;
		margin: 0.4rem 0 0;
		font-size: 0.92rem;
	}
	.flags caption {
		caption-side: top;
		text-align: left;
		font-weight: 600;
		color: var(--text-bright);
		padding: 0 0 0.5rem;
	}
	.flags th, .flags td {
		text-align: left;
		vertical-align: top;
		padding: 0.55rem 0.6rem 0.55rem 0;
		border-top: 1px solid var(--border);
	}
	.flags th { white-space: nowrap; padding-right: 1.2rem; font-weight: 500; }
	.flags td { color: var(--text-muted); }

	/* The by-hand list: commands, an optional note, then the verify line. */
	.hand { margin-top: 1.6rem; }
	.hand :global(.step-body p) { line-height: 1.8; }
	.hand :global(.step-body code) { font-size: 0.86em; }
	.hand :global(.note) { color: var(--text-muted); }
	.hand :global(.verify) { color: var(--text); }
	.hand :global(.verify strong) { color: var(--green); font-weight: 700; }

	/* -------------------------------------------------- what happened -- */
	.happened :global(.shot) { margin-top: 3rem; }

	/* ---------------------------------------------------------- deploy -- */
	.accounts {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
		display: grid;
		gap: 1rem;
	}
	.accounts > li {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) 15rem;
		gap: 0.6rem 1.2rem;
		align-items: start;
		padding: 1.2rem 1.4rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--card);
	}
	.acct-body { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
	.acct-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.7rem; }
	.accounts strong { color: var(--text-bright); font-size: 1.15rem; }
	.accounts .role { font-size: 0.88rem; color: var(--text-muted); }
	.accounts .first { font-size: 0.95rem; margin: 0; max-width: 60ch; }
	.accounts .mint { font-size: 0.88rem; margin: 0; color: var(--text-muted); }
	.accounts .vars { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; vertical-align: middle; }
	.accounts .vars code { font-size: 0.78rem; }
	.acct-links {
		list-style: none;
		margin: 0;
		padding: 0.1rem 0 0 1.2rem;
		border-left: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.92rem;
	}
	.acct-links a { font-weight: 600; text-decoration: none; }
	.acct-links a:hover { text-decoration: underline; }
	.acct-links .acct-primary { color: var(--orange-ink); font-size: 1rem; }
	@media (max-width: 760px) {
		.accounts > li { grid-template-columns: auto minmax(0, 1fr); padding: 1rem; }
		.acct-links { grid-column: 2; border-left: 0; padding-left: 0; }
	}

	/* ---------------------------------------------------------- honest -- */
	.notes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2rem;
	}
	/* The component's own vertical margin, unwanted in a grid. */
	.notes :global(.callout) { margin: 0; }
	@media (max-width: 760px) { .notes { grid-template-columns: 1fr; } }

	/* ----------------------------------------------------------- yours -- */
	@media (max-width: 1000px) {
		/* minmax(0, …): a scrolling index in a 1fr column would widen it. */
		.gs-body { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
		.side { position: static; padding-top: 2.4rem; }
		.side nav {
			flex-direction: row;
			gap: 0.3rem;
			overflow-x: auto;
			border-left: 0;
			border-bottom: 2px solid var(--border);
			padding-bottom: 0.4rem;
			scrollbar-width: thin;
		}
		.side-link { border-left: 0; margin-left: 0; padding: 0.3rem 0.6rem; border-radius: 999px; }
		.side-link.current { border-left: 0; background: var(--tint-orange); }
		.gs-main > section { padding: 2.6rem 0; }
	}

	.yours p { color: var(--text-muted); }
	.yours p code { font-size: 0.85em; }
</style>

<script>
	// Mark the section in view in the index. Progressive: the links work without it.
	const links = new Map<string, HTMLElement>()
	for (const a of document.querySelectorAll<HTMLElement>('.side-link[data-section]'))
		links.set(a.dataset.section ?? '', a)
	const sections = document.querySelectorAll<HTMLElement>('.gs-main > section[id]')
	if ('IntersectionObserver' in window && sections.length) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue
					links.forEach((a) => a.classList.remove('current'))
					links.get(e.target.id)?.classList.add('current')
				}
			},
			{ rootMargin: '-25% 0px -65% 0px', threshold: 0 }
		)
		sections.forEach((sec) => io.observe(sec))
	}
</script>
