---
/**
 * The landing page. No two neighbours share a layout family:
 * hero (sky) → the story (five alternating chapters, the rocket diving down the gutter between
 * them) → yours to keep (dark band, three paths) → first run (the prompt | the chat, on a
 * card between two cloud edges) → already built (five group cards) → under the hood (dark band)
 * → who it is for (four cards) → before you start (three callouts) → questions → call to action.
 *
 * Every kit literal quoted here comes from src/data/get-started.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SkyScene from '../components/SkyScene.astro'
import CloudDivider from '../components/CloudDivider.astro'
import ConceptIcon from '../components/ConceptIcon.astro'
import LogoMark from '../components/LogoMark.astro'
import SectionHead from '../components/SectionHead.astro'
import Screenshot from '../components/Screenshot.astro'
import AgentChat from '../components/AgentChat.astro'
import Terminal from '../components/Terminal.astro'
import Callout from '../components/Callout.astro'
import { CONCEPT_COUNT, numberWord } from '../data/concepts'
import { pageByPath } from '../data/pages'
import {
	AGENT_NAME,
	APP_URL,
	BOOTSTRAP_EXPECT,
	BOOTSTRAP_STEPS,
	INSTALL_CMD,
	START_DURATION,
	START_PROMPT,
	START_STEPS,
} from '../data/get-started'

import agentsLight from '../assets/screens/agents-run.light.png'
import agentsDark from '../assets/screens/agents-run.dark.png'
import analyticsLight from '../assets/screens/analytics.light.png'
import analyticsDark from '../assets/screens/analytics.dark.png'
import peopleLight from '../assets/screens/people.light.png'
import peopleDark from '../assets/screens/people.dark.png'

const page = pageByPath('/')
if (!page) throw new Error('Page not in the registry: /')

const description =
	'Turn a problem or a prototype into real software you own: AI at its core, secure from the first day, built to grow, and run for you if you want. Build it yourself, have a partner build it, or let us run it.'

/**
 * The story under the hero, for a reader who is not an engineer: one chapter per promise,
 * alternating sides. Every claim is one the concept and security pages already document.
 */
const chapters: {
	id: string
	tone: string
	eyebrow: string
	title: string
	body: string[]
	href: string
	linkLabel: string
	/** A screenshot; or `checks`, drawn as a ticked list; or `modules`, drawn as parts that snap in. */
	light?: ImageMetadata
	dark?: ImageMetadata
	alt?: string
	url?: string
	checks?: string[]
	modules?: string[]
}[] = [
	{
		id: 'real',
		tone: 'purple',
		eyebrow: 'Real software',
		title: 'Built properly. Not just built quickly.',
		body: [
			'A prototype is a brilliant way to show an idea. It is a less brilliant way to run a business. Rocketflare gives your idea the foundations real software needs, designed by an experienced CTO and engineers who have run software at global scale.',
			'Every change is checked before it goes live, whoever made it, human or AI. So when your IT team, or an investor’s due diligence, looks under the hood, they nod instead of wince.',
		],
		href: '/concepts/',
		linkLabel: 'How it is built',
		checks: [
			'Each customer’s data kept separate',
			'People see only what their role allows',
			'Every change tested before it goes live',
			'AI use tracked and costed',
			'Constantly tested for security holes',
			'Every design choice written down',
		],
	},
	{
		id: 'build',
		tone: 'orange',
		eyebrow: 'Build anything',
		title: 'Build anything. Start with the boring bits done.',
		body: [
			'Your app is made of modules that snap together. A public website, dashboards, sign-in with work accounts, your accounting system, Microsoft 365 calendars: add the module, skip the six-month project.',
			'Then build the part only your business has: an internal tool, a product you sell, or both. New modules keep arriving, and your app keeps up with them.',
		],
		href: '/plugins/',
		linkLabel: 'See the modules',
		modules: [
			'Website builder',
			'Dashboards',
			'Company sign-in',
			'Accounting',
			'Microsoft 365',
			'Search',
			'Feedback',
			'Your own',
		],
	},
	{
		id: 'ai',
		tone: 'red',
		eyebrow: 'AI at the core',
		title: 'AI that does the work, not just the chat.',
		body: [
			'Most software bolts AI on as a chat box in the corner. Here it is built in. AI agents take on whole tasks, show their working, and answer from your own documents, receipts included.',
			'They can only see and do what the person using them is allowed to, so you can put them to work without a nervous call to legal. Your team can even use the app from Claude or ChatGPT.',
		],
		href: '/concepts/ai/',
		linkLabel: 'How the AI fits in',
		light: agentsLight,
		dark: agentsDark,
		alt: 'An AI agent’s task: the timeline of its steps and the finished summary',
		url: 'your-app.com/agents',
	},
	{
		id: 'secure',
		tone: 'blue',
		eyebrow: 'Secure from the first day',
		title: 'Your customers’ data stays theirs.',
		body: [
			'Sell to many customers and each one’s data is kept strictly apart. Run it for one company and it gets its own app and its own database, shared with no one.',
			'People sign in with their work Google or Microsoft account and see only what their role allows. Meanwhile, automated security testers keep trying to break in, so the holes are found by us, not by someone less friendly.',
		],
		href: '/security/',
		linkLabel: 'How we keep it secure',
		light: peopleLight,
		dark: peopleDark,
		alt: 'The People page: members with their roles and a pending invitation',
		url: 'your-app.com/settings',
	},
	{
		id: 'ready',
		tone: 'green',
		eyebrow: 'Ready for real use',
		title: 'Grows with you. Looked after once it’s live.',
		body: [
			'It runs on Cloudflare’s worldwide network, so it is quick wherever your users are, and it grows from your first ten users to thousands without a rebuild.',
			'Dashboards show how it is used and what the AI is costing you, before the bill does. Rather not run it yourself? We will: hosting, updates, security fixes and support, priced on what the app uses, not on how many people use it. Keep your weekends.',
		],
		href: '/costs/',
		linkLabel: 'What running it costs',
		light: analyticsLight,
		dark: analyticsDark,
		alt: 'A dashboard with live numbers for members and activity',
		url: 'your-app.com/analytics',
	},
]

/** The three ways to get an app built and run; every one ends with the customer owning it. */
const paths = [
	{
		title: 'Build it yourself',
		body: 'Describe what you want in plain words and build it with AI, one step at a time.',
		href: '#first-run',
		linkLabel: 'Start with one prompt',
	},
	{
		title: 'Have a partner build it',
		body: 'A Rocketflare partner builds it for you. You keep the code, and you can change partners if you ever need to.',
		href: '/partners/',
		linkLabel: 'Meet the partners',
	},
	{
		title: 'Let us run it',
		body: 'We host, patch, monitor and support it, however it was built. A monthly fee that follows real usage, with transparent metrics, and no per-user licences. Want it back? It’s yours. It always was.',
		href: '/costs/',
		linkLabel: 'How running it works',
	},
]

/** Who it is for: the four readers this page now speaks to, each with the next step that fits. */
const audiences = [
	{
		tone: 'orange',
		icon: 'rocket',
		title: 'You have an idea, maybe a prototype',
		body: 'And you’d like it to survive contact with real customers. Build it properly from the first day, with AI doing the heavy lifting.',
		href: '#first-run',
		linkLabel: 'Start with one prompt',
	},
	{
		tone: 'blue',
		icon: 'building',
		title: 'Your business rents software that almost fits',
		body: 'Swap the workarounds and the per-seat invoices for an app built around how you actually work. A partner can build it, and we can run it.',
		href: '/partners/',
		linkLabel: 'Talk to a partner',
	},
	{
		tone: 'green',
		icon: 'puzzle',
		title: 'You build software for clients',
		body: 'Deliver applications your clients own, on foundations you don’t rebuild every time. Partners get commercial plugins and support from the people who build the kit.',
		href: '/partners/',
		linkLabel: 'Become a partner',
	},
	{
		tone: 'purple',
		icon: 'shield',
		title: 'You’re the one who has to sign it off',
		body: 'IT, security or technical due diligence. Every design decision is written down with its reasons, and how we test security is published. Bring your hardest questions.',
		href: '/concepts/',
		linkLabel: 'Every decision, with its reasons',
	},
]

/** What is already built: the whole inventory, in five groups, in words a non-engineer reads. */
const built = [
	{
		title: 'People and access',
		icon: 'users',
		tone: 'blue',
		href: '/tour/#people',
		items: [
			'Sign-in with an email link, Google, Microsoft or your company’s single sign-on',
			'Invite people, give them roles, change your mind later',
			'Groups for departments, regions or clients, each seeing only its own',
			'An admin area to see every customer and step in to help',
			'Switches to turn a new feature on one customer at a time',
		],
	},
	{
		title: 'AI that does the work',
		icon: 'sparkles',
		tone: 'red',
		href: '/tour/#chat',
		items: [
			'Chat that answers as it types and remembers the thread',
			'Agents that run whole tasks while you watch the steps',
			'Agents that stop and ask before anything important',
			'Upload your documents, get answers with sources',
			'Search by meaning, not just by keyword',
			'Use the app from Claude or ChatGPT, as yourself',
		],
	},
	{
		title: 'Knowing what’s going on',
		icon: 'gauge',
		tone: 'orange',
		href: '/tour/#usage',
		items: [
			'A dashboard for every customer from day one',
			'Every AI call priced, before the bill arrives',
			'Every agent run recorded, step by step',
			'Tests that catch a worse AI answer before your customers do',
		],
	},
	{
		title: 'The plumbing, done',
		icon: 'bolt',
		tone: 'cyan',
		href: '/concepts/',
		items: [
			'Emails for sign-in and invitations',
			'File uploads, stored safely',
			'Long jobs run in the background, and pages update live',
			'One command to staging, one to production',
			'A command line and API keys for automation',
			'Tests that fail if one customer could ever see another’s data',
		],
	},
	{
		title: 'Modules you can add',
		icon: 'puzzle',
		tone: 'green',
		href: '/plugins/',
		items: [
			'A website builder with forms, in several languages (partner)',
			'Enterprise single sign-on with SAML, and people added and removed from your directory (partner)',
			'Your Microsoft 365 directory and calendars',
			'Accounting, through FreeAgent',
			'Email straight into the app',
			'Feedback and bug reports from your users',
			'A built-in guide, and search across the app and the web',
		],
	},
]

const conceptCount = numberWord(CONCEPT_COUNT)

/** What the agent does with the prompt — the rf-start steps in plain words. */
const agentTurns = [
	{ who: 'you' as const, text: `${START_PROMPT[0]} …` },
	{
		who: 'agent' as const,
		text: 'Cloned it into my-app and read CLAUDE.md. Running rf-start with you:',
		checks: START_STEPS,
	},
	{
		who: 'agent' as const,
		text: 'Your app has its own name, brand and design. Start Claude again inside my-app and ask for Stage 1.',
	},
]

/** The secondary path: the one-line installer, no design step. */
const installLines = [{ cmd: INSTALL_CMD }]

/**
 * The questions people actually ask before they commit a weekend to a starter
 * kit. Rendered as a section AND as the FAQPage schema below, from this one
 * array — structured data has to mirror what a reader can see, and the way to
 * guarantee that is to have one source for both.
 */
const FAQS: { q: string; a: string }[] = [
	{
		q: 'What is Rocketflare?',
		a: 'A free, open-source web app you copy and make your own. Sign-in, organisations, teams and permissions, an AI assistant that answers from your own documents, file uploads and background jobs are already built and tested, and dashboards are one command away. You add the product. It runs as one Cloudflare Worker over a normal Postgres database, under the MIT licence.',
	},
	{
		q: 'Do I need to be a developer to use it?',
		a: 'You need to be comfortable running commands in a terminal, and you will be editing code eventually — this is a codebase, not a no-code builder. You do not need to know Cloudflare, Postgres or any of the libraries beforehand. The repository is written to be driven by a coding agent such as Claude Code: paste the prompt from the Get started page and it sets the app up, designs it with you and renames it, showing each step as it goes. Deploying is one more skill, /rf-provision, which you run yourself.',
	},
	{
		q: 'What does it cost?',
		a: 'The kit is free. Running it on your laptop costs nothing at all. Deploying it costs the Cloudflare Workers Paid plan, because the database connection pool and the workflows the agents run on are paid features, plus a Postgres database — a free Neon tier is enough to start. The built-in AI is billed per call to your own Cloudflare account, with a free daily allowance, and you can switch it off or bring your own key.',
	},
	{
		q: 'Can I use it for a commercial product or for client work?',
		a: 'Yes. It is MIT licensed: build a product on it, charge for that product, keep your changes private, and you owe nothing and need not credit anyone. Take a copy, cut it loose from the original history, and it is your codebase.',
	},
	{
		q: 'Do I need a Cloudflare account?',
		a: 'To run it on your laptop, a free one — and only because the built-in AI runs on Cloudflare, so the first start asks you to log in. Run the bootstrap with --offline and no account is needed at all; chat and agents then wait for an AI key of your own. Deploying needs a Workers Paid plan.',
	},
	{
		q: 'Can it serve one organisation or many?',
		a: 'Both, from the same database. One setting switches between many organisations, each with its own members and roles, and a single organisation that everyone joins. You can change your mind later without touching the data or running a migration.',
	},
	{
		q: 'What is not included?',
		a: 'Billing and subscriptions: there is no Stripe integration, no plans and no metering of your customers yet. That is on the roadmap. There is no native mobile app either; the app works in a phone’s browser. Two things you might expect to find missing are available as partner plugins: a website builder with forms and several languages, and enterprise single sign-on with SAML and SCIM. Everything underneath a business app is included: sign-in, roles, files, email, background jobs, AI, and dashboards you add in one command.',
	},
	{
		q: 'How is it different from other SaaS starter kits?',
		a: 'Three things. Multi-tenancy is the foundation rather than an add-on, so every row belongs to an organisation and the tests fail if one does not. The AI layer — chat, agents and search over your own documents — is built in and works on a fresh copy with no API key. And a copy keeps a link home: when the kit gains a release, one command ports it into your renamed app without recreating anything you deleted, so starting from a template does not mean falling behind it.',
	},
	{
		q: 'Is it for one product, or for many?',
		a: 'As many as you have ideas. Copy the kit once per product: each copy is renamed to its own app, deploys on its own, and keeps taking the kit’s releases and plugins, so the tenth product starts as current as the first. One kit and a coding agent, turning out SaaS products for as long as you keep having ideas: an infinite SaaS factory rather than a one-off template.',
	},
	{
		q: 'What does “agent-first” mean?',
		a: 'The kit is written to be worked on by a coding agent: a map at the root of the repository, rules that load with the files they apply to, a guide in every important folder, and one test gate that enforces them. Ask the agent to set up, rename or deploy the project and it follows the same steps a person would, showing each result as it goes.',
	},
]

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQS.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a },
	})),
}
---

<BaseLayout title={page.title} description={description} jsonLd={faqLd}>
	<!-- ====================================================== 1 · hero -->
	<header class="hero">
		<SkyScene />
		<div class="hero-inner wrap">
			<div class="hero-copy">
				<h1>Stop renting software<br /><span class="misfit-line">that doesn't <span class="misfit">fit</span></span></h1>
				<p class="lede">
					Start from a problem worth solving or a prototype that proves the idea, and turn it into real
					software with AI at its core. We handle the hard parts, like security and keeping it running at 3am. Build it yourself, bring in a partner,
					or hand it to us. Either way, it's yours.
				</p>
				<p class="owned-line"><strong>The SaaS you own.</strong> Build anything you like, then we can run it for you so it feels like SaaS. You pay for what it uses, with the numbers in plain sight. No per-user licences. Or you can run it yourself.</p>
				<div class="hero-actions">
					<a href="#first-run" class="btn btn-primary">
						Start with one prompt
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</a>
					<a href="/partners/" class="btn btn-secondary">Have a partner build it</a>
				</div>
			</div>
		</div>
		<CloudDivider fill="var(--bg)" />
	</header>

	<!-- ====================================== 2b · the story, one chapter each -->
	<section class="story" aria-label="Why Rocketflare">
		<!-- The rocket dives down the gutter between the chapters as the page scrolls (CSS scroll timeline, no script). -->
		<div class="story-track" aria-hidden="true">
			<div class="story-rocket">
				<svg viewBox="0 0 220 470" width="64" height="137">
					<path fill="var(--red)" d="M62 150C30 168 12 200 6 246l56-22z"/>
					<path fill="var(--red)" d="M158 150c32 18 50 50 56 96l-56-22z"/>
					<path fill="var(--blue-bright)" d="M110 8C67 43 46 98 46 168v108c0 20 14 34 34 34h60c20 0 34-14 34-34V168c0-70-21-125-64-160z"/>
					<path fill="var(--blue)" d="M110 8c14 35 22 88 22 160v150h8c20 0 34-14 34-34V168c0-70-21-125-64-160z" opacity="0.55"/>
					<path fill="var(--yellow-bright)" d="M110 8C86 28 70 53 60 83h100C150 53 134 28 110 8z"/>
					<circle cx="110" cy="140" r="30" fill="var(--cloud)"/>
					<circle cx="110" cy="140" r="20" fill="var(--cyan-soft)"/>
					<path fill="var(--text-muted)" d="M78 306h64l-10 34H88z"/>
					<g class="story-flame">
						<path fill="var(--yellow-bright)" d="M110 336c-22 34-33 62-33 84 0 19 15 30 33 30s33-11 33-30c0-22-11-50-33-84z"/>
						<path fill="var(--orange)" d="M110 348c-14 26-21 47-21 62 0 13 9 21 21 21s21-8 21-21c0-15-7-36-21-62z"/>
					</g>
				</svg>
			</div>
		</div>
		<div class="wrap">
			{chapters.map((ch, i) => (
				<article class:list={['chapter', i % 2 === 1 && 'chapter-flip', `tone-${ch.tone}`]} aria-labelledby={`chapter-${ch.id}`}>
					<div class="chapter-copy reveal">
						<p class="chapter-eyebrow"><span class="chapter-num">{String(i + 1).padStart(2, '0')}</span>{ch.eyebrow}</p>
						<h2 id={`chapter-${ch.id}`}>{ch.title}</h2>
						{ch.body.map((para) => <p>{para}</p>)}
						<a class="chapter-link" href={ch.href}>{ch.linkLabel} <span aria-hidden="true">→</span></a>
					</div>
					<div class="chapter-shot reveal">
						{ch.checks ? (
							<div class="checks-card">
								<p class="checks-head">Checked on every change</p>
								<ul class="checks">
									{ch.checks.map((c) => (
										<li>
											<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
											{c}
										</li>
									))}
								</ul>
								<p class="checks-foot">All checks passed. Every time.</p>
							</div>
						) : ch.modules ? (
							<div class="checks-card">
								<p class="checks-head">Add what you need</p>
								<ul class="modules">
									{ch.modules.map((m, j) => <li class:list={[j === ch.modules!.length - 1 && 'module-own']}>{j === ch.modules!.length - 1 ? `+ ${m}` : m}</li>)}
								</ul>
								<p class="checks-foot">Or build your own. We won’t be offended.</p>
							</div>
						) : (
							ch.light && ch.dark && ch.alt && <Screenshot light={ch.light} dark={ch.dark} alt={ch.alt} url={ch.url} crop="top" width={620} />
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- ============================================= 2c · yours to keep -->
	<section class="bg-band owned" aria-labelledby="owned-title">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					eyebrow="The SaaS you own"
					title="Your software. Your IP."
					lede="Build anything you like. Then it runs like SaaS: we handle hosting, updates, security and support, for a monthly fee that scales with what the app actually uses. You see the same metrics we do, and nobody counts seats. The app, the code and the data stay yours, and you can move them to your own team, a partner or another host whenever you like. We keep your business the old-fashioned way: by being worth keeping."
				/>
			</div>
			<ol class="paths reveal reveal-stagger">
				{paths.map((p) => (
					<li>
						<h3>{p.title}</h3>
						<p>{p.body}</p>
						<a href={p.href}>{p.linkLabel} <span aria-hidden="true">→</span></a>
					</li>
				))}
			</ol>
		</div>
		<CloudDivider fill="var(--card)" />
	</section>

	<!-- ================================================= 3 · first run -->
	<section class="firstrun" id="first-run">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					audience="builder"
					title="Start with one prompt"
					lede="Install Claude Code, open it in the folder where you keep your projects, and paste this."
				/>
			</div>
			<div class="split">
				<div class="split-term reveal">
					<Terminal
						title={AGENT_NAME}
						lines={START_PROMPT.map((out) => ({ out }))}
						copy={START_PROMPT.join('\n')}
						wrap
					/>
					<p class="next">
						It gets the app running on your machine, then holds a design conversation with you: how
						many organisations, the roles and the words your users use, AI on or off, money, the
						licence, which existing plugins already do what you need, the stages, and your brand. It
						shows the design as pages in your colours, then renames the kit to your app. Allow
						{START_DURATION}, most of it the conversation.
					</p>
				</div>
				<div class="split-chat reveal">
					<AgentChat agent={AGENT_NAME} turns={agentTurns} />
				</div>
			</div>
			<div class="strip reveal">
				<h3 class="strip-head">Only want to try the kit first?</h3>
				<p>
					The installer clones it, makes the history yours from the first commit, and runs the
					bootstrap: {numberWord(BOOTSTRAP_STEPS.length)} checked steps, then {APP_URL} opens, signed
					in as the demo owner. Design and rename it later.
				</p>
				<Terminal title="zsh" lines={installLines} expect={BOOTSTRAP_EXPECT} />
			</div>
			<p class="strip-more">
				<a href="/get-started/">Every path, step by step, and the Windows steps <span aria-hidden="true">→</span></a>
			</p>
		</div>
		<CloudDivider fill="var(--bg)" />
	</section>

	<!-- =============================================== 4 · what it does -->
	<section class="what">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					eyebrow="Out of the box"
					title="Already built, so you don’t have to"
					lede="Everything a serious app needs on day one, before you’ve written a word of your own. Partner plugins come with a partner agreement. The tour shows every screen."
				/>
			</div>
			<div class="built reveal reveal-stagger">
				{built.map((g) => (
					<article class={`built-group tone-${g.tone}`}>
						<h3><span class="chip"><ConceptIcon name={g.icon} /></span>{g.title}</h3>
						<ul>
							{g.items.map((it) =>
