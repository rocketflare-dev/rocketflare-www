<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* --------------------------------------------------------- 1 · hero -- */
	.hero {
		position: relative;
		min-height: min(92vh, 880px);
		display: flex;
		align-items: center;
		padding: 5rem 0 13rem;
		overflow: hidden;
	}
	.hero-inner { position: relative; z-index: 2; width: 100%; }
	.hero-copy { max-width: 900px; }
	/* The headline's joke: "fit." does not fit its box. The word is tilted and pokes out of a
	   dashed frame drawn too small for it, and jostles against it once on load. The frame sits
	   behind the letters (z-index -1 inside the isolated word), so its dashes never cross them. */
	/* A vivid red-orange that still clears 3:1 on the light sky; the night sky takes the bright orange. */
	.misfit-line { color: color-mix(in srgb, var(--red) 85%, var(--text-bright)); }
	:global(html[data-theme='night']) .misfit-line { color: var(--orange); }
	:global(html[data-theme='night']) .misfit { color: var(--blue-bright); }
	/* Yellow over navy turns olive: at night the frame is its dashed edge alone. */
	:global(html[data-theme='night']) .misfit::before { background: transparent; border-color: var(--yellow-bright); }
	.misfit {
		position: relative;
		display: inline-block;
		margin-left: 0.08em;
		color: color-mix(in srgb, var(--blue-bright) 85%, var(--text-bright));
		isolation: isolate;
		transform: rotate(-5deg);
		transform-origin: 20% 80%;
		animation: jostle 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
	}
	.misfit::before {
		content: '';
		position: absolute;
		left: -0.12em;
		top: 0.1em;
		bottom: 0;
		width: 68%;
		z-index: -1;
		border: 0.06em dashed color-mix(in srgb, var(--yellow-bright) 75%, var(--orange));
		border-radius: 0.14em;
		background: color-mix(in srgb, var(--yellow-bright) 45%, transparent);
		transform: rotate(6deg);
		pointer-events: none;
	}
	@keyframes jostle {
		0%   { transform: rotate(0deg) translateX(-0.15em); }
		45%  { transform: rotate(-9deg) translateX(0.05em); }
		70%  { transform: rotate(-3deg); }
		100% { transform: rotate(-5deg); }
	}
	.lede {
		font-size: var(--step-1);
		color: var(--text);
		max-width: 58ch;
		margin-bottom: 1.1rem;
	}
	.owned-line strong { color: var(--text-bright); }
	.owned-line {
		font-size: 1.05rem;
		color: var(--text);
		max-width: 58ch;
		letter-spacing: 0.01em;
		margin-bottom: 1.9rem;
	}
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

	/* ----------------------------------------------------- 2b · the story -- */
	.story {
		position: relative;
		padding: 4rem 0 5rem;
		background: var(--bg);
		view-timeline: --story block;
	}
	.chapter {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 9rem;
		align-items: center;
		padding: 3.5rem 0;
	}
	.chapter-flip .chapter-copy { order: 2; }
	.chapter-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0 0 0.8rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-ink, var(--accent));
