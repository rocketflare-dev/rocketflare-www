	.chapter-shot :global(.modules) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.7rem;
	}
	.chapter-shot :global(.modules li) {
		padding: 0.85rem 1rem;
