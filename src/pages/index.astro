		background: transparent;
		border-style: dashed;
		border-color: var(--accent);
		color: var(--accent-ink, var(--accent));
	}

	/* The flight path: a faint dashed line down the gutter, and the rocket held in view on it. */
	.story-track {
		position: absolute;
		top: 6rem;
		bottom: 6rem;
		left: 50%;
		width: 0;
		border-left: 2px dashed color-mix(in srgb, var(--text-muted) 28%, transparent);
		z-index: 1;
	}
	/* Held mid-screen while the chapters scroll past, nose down, so it reads as diving through them. */
	.story-rocket {
		position: sticky;
		top: calc(50vh - 68px);
		width: 64px;
		margin-left: -33px;
	}
	.story-rocket svg { display: block; transform: rotate(180deg); }
	@supports (animation-timeline: view()) {
		.story-rocket svg {
			animation: dive linear both;
			animation-timeline: --story;
			animation-range: entry 20% exit 80%;
		}
		.story-flame { transform-origin: 110px 336px; animation: story-flicker 0.18s ease-in-out infinite alternate; }
	}
	/* Leans toward each chapter's picture in turn: right, left, right, left, right. */
	@keyframes dive {
		0%   { transform: translateY(-40px) rotate(180deg) scale(0.7); opacity: 0; }
		7%   { transform: translateY(0) rotate(180deg) scale(1); opacity: 1; }
		18%  { transform: translateX(26px) rotate(166deg); }
		34%  { transform: translateX(-26px) rotate(194deg); }
		50%  { transform: translateX(26px) rotate(166deg); }
		66%  { transform: translateX(-26px) rotate(194deg); }
		82%  { transform: translateX(26px) rotate(166deg); }
		93%  { transform: translateY(0) rotate(180deg) scale(1); opacity: 1; }
		100% { transform: translateY(60px) rotate(180deg) scale(0.8); opacity: 0; }
	}
	@keyframes story-flicker { from { transform: scaleY(0.82); } to { transform: scaleY(1.12); } }
	@media (prefers-reduced-motion: reduce) {
		.story-rocket svg, .story-flame { animation: none !important; }
	}
	@media (max-width: 900px) {
		.story { padding-top: 1rem; }
		.chapter { grid-template-columns: minmax(0, 1fr); gap: 2rem; padding: 2.5rem 0; }
		.chapter:first-child { padding-top: 0; }
		.chapter-flip .chapter-copy { order: 0; }
		.story-track { display: none; }
	}

	/* -------------------------------------------------- 2c · yours to keep -- */
	.owned { position: relative; padding: 5.5rem 0 clamp(8rem, 12vw, 10.5rem); }
