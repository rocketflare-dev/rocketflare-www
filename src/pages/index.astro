---
/**
 * The landing page. Nine sections, no two neighbours sharing a layout family:
 * hero (sky) → proof (one big screenshot) → first run (chat | terminal, on a
 * card between two cloud edges) → what it does (triptych) → also included
 * (flat icon list) → under the hood (dark band) → who it is for (two columns)
 * → before you start (three callouts) → call to action.
 *
 * Every kit literal quoted here comes from src/data/get-started.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SkyScene from '../components/SkyScene.astro'
import CloudDivider from '../components/CloudDivider.astro'
import ConceptIcon from '../components/ConceptIcon.astro'
import LogoMark from '../components/LogoMark.astro'
import SectionHead from '../components/SectionHead.astro'
import Screenshot from '../components/Screenshot.astro'
import AgentChat from '../components/AgentChat.astro'
import Terminal from '../components/Terminal.astro'
import Steps from '../components/Steps.astro'
import Callout from '../components/Callout.astro'
import { GITHUB_URL } from '../data/site'
import { CONCEPT_COUNT, conceptBySlug, numberWord } from '../data/concepts'
import { pageByPath } from '../data/pages'
import {
	AGENT_NAME,
	AGENT_PROMPT,
	APP_URL,
	BOOTSTRAP_EXPECT,
	BOOTSTRAP_READY_LINE,
	BOOTSTRAP_STEPS,
	bootstrapLine,
	INSTALL_CMD,
	DEMO,
} from '../data/get-started'

import homeLight from '../assets/screens/home.light.png'
import homeDark from '../assets/screens/home.dark.png'
import chatLight from '../assets/screens/chat.light.png'
import chatDark from '../assets/screens/chat.dark.png'
import agentsLight from '../assets/screens/agents-run.light.png'
import agentsDark from '../assets/screens/agents-run.dark.png'
import documentsLight from '../assets/screens/documents.light.png'
import documentsDark from '../assets/screens/documents.dark.png'
import analyticsLight from '../assets/screens/analytics.light.png'
import analyticsDark from '../assets/screens/analytics.dark.png'
import peopleLight from '../assets/screens/people.light.png'
import peopleDark from '../assets/screens/people.dark.png'

const page = pageByPath('/')
if (!page) throw new Error('Page not in the registry: /')

const description =
	'Rocketflare is a ready-made web app you copy and make your own: sign-in, teams and permissions, an AI assistant that reads your documents, dashboards and background jobs — one Cloudflare Worker over Postgres, open source, running on your laptop in about two minutes.'

/** The four thumbnails under the big screenshot; ids are the tour page's anchors. */
const thumbs = [
	{ id: 'chat', label: 'Chat', light: chatLight, dark: chatDark, alt: 'A chat thread with the built-in assistant' },
	{ id: 'agents', label: 'Agents', light: agentsLight, dark: agentsDark, alt: 'An agent run with its timeline of steps' },
	{ id: 'knowledge', label: 'Knowledge', light: documentsLight, dark: documentsDark, alt: 'The Knowledge page listing indexed documents' },
	{ id: 'analytics', label: 'Analytics', light: analyticsLight, dark: analyticsDark, alt: 'The Organisation Overview dashboard' },
]

/** The triptych: one screenshot, one title, three outcomes. */
const panels = [
	{
		title: 'People and sign-in',
		light: peopleLight,
		dark: peopleDark,
		alt: 'The People page: members with their roles and a pending invitation',
		url: 'localhost:3000/settings?tab=people',
		points: [
			'Sign in with a link in your email, or with Google, Microsoft or any other single sign-on provider.',
			'Owners, admins and members — one rule decides what a page shows and what the server allows.',
			'Invite people; the list updates live in every open browser.',
		],
	},
	{
		title: 'An assistant and agents',
		light: agentsLight,
		dark: agentsDark,
		alt: 'An agent run: the timeline of steps and the finished summary',
		url: 'localhost:3000/agents',
		points: [
			'Chat that streams answers and remembers the thread.',
			'Agents that run long tasks in the background and show their steps as they go.',
			'Drop in PDFs and documents; search them by meaning and let the assistant cite them.',
		],
	},
	{
		title: 'Dashboards',
		light: analyticsLight,
		dark: analyticsDark,
		alt: 'The Organisation Overview dashboard with live member and activity numbers',
		url: 'localhost:3000/analytics',
		points: [
			'An organisation overview on day one, with live numbers.',
			'Build your own pages from the same data, no SQL required.',
			'Every AI call is recorded with what it cost, before Cloudflare sends the bill.',
		],
	},
]

/** Also included — one line each, linking to the concept page that explains it. */
const also = [
	{ slug: 'background-work', icon: 'bolt', title: 'Background jobs and realtime', line: 'Long work runs off the request; open pages hear about it and refresh.' },
	{ slug: 'email-and-files', icon: 'inbox', title: 'Email and files', line: 'Sign-in and invitation mail, plus uploads with avatars wired end to end.' },
	{ slug: 'cli', icon: 'terminal', title: 'A command-line tool', line: 'Log in from the terminal and script what the app can do.' },
	{ slug: 'auth', icon: 'key', title: 'API keys', line: 'Per-organisation keys you can mint and revoke in Settings.' },
	{ slug: 'tenancy', icon: 'building', title: 'An admin area', line: 'See every organisation, approve sign-ups, step in to help a customer.' },
	{ slug: 'ai', icon: 'gauge', title: 'AI usage, priced and traced', line: 'Every model call costed per organisation, every run a span tree in Langfuse, Phoenix or your terminal.' },
	{ slug: 'database', icon: 'database', title: 'Tests that guard isolation', line: 'The suite fails if one organisation could ever see another’s rows.' },
	{ slug: 'deployment', icon: 'cloud', title: 'One-command deploys', line: 'Staging from a tag, production from a release, secrets never in a file.' },
	{ slug: 'plugins', icon: 'puzzle', title: 'Plugins', line: 'Add a capability by copying a repository in, not by installing a package.' },
].map((a) => {
	const c = conceptBySlug(a.slug)
	if (!c) throw new Error(`Unknown concept: ${a.slug}`)
	return { ...a, href: `/concepts/${c.slug}/`, tone: c.tone }
})

const conceptCount = numberWord(CONCEPT_COUNT)

/** What the agent says it did — every bootstrap step in plain words. */
const agentTurns = [
	{ who: 'you' as const, text: AGENT_PROMPT },
	{
		who: 'agent' as const,
		text: 'Reading CLAUDE.md, then running the first-run script. Here is what it did:',
		checks: BOOTSTRAP_STEPS.map((s) => s.plain),
	},
	{
		who: 'agent' as const,
		text: `You're signed in as the demo owner. Try Chat, Agents, Knowledge or Analytics.`,
	},
]

const terminalLines = [
	{ cmd: INSTALL_CMD },
	...BOOTSTRAP_STEPS.map((_, i) => ({ out: bootstrapLine(i), ok: true })),
	{ out: BOOTSTRAP_READY_LINE, ok: true },
]

/**
 * The questions people actually ask before they commit a weekend to a starter
 * kit. Rendered as a section AND as the FAQPage schema below, from this one
 * array — structured data has to mirror what a reader can see, and the way to
 * guarantee that is to have one source for both.
 */
const FAQS: { q: string; a: string }[] = [
	{
		q: 'What is Rocketflare?',
		a: 'A free, open-source web app you copy and make your own. Sign-in, organisations, teams and permissions, an AI assistant that answers from your own documents, dashboards, file uploads and background jobs are already built and tested. You add the product. It runs as one Cloudflare Worker over a normal Postgres database, under the MIT licence.',
	},
	{
		q: 'Do I need to be a developer to use it?',
		a: 'You need to be comfortable running commands in a terminal, and you will be editing code eventually — this is a codebase, not a no-code builder. You do not need to know Cloudflare, Postgres or any of the libraries beforehand. The repository is written to be driven by a coding agent such as Claude Code: open the folder, type /rf-setup, and it does the setup, the rename and the deploy for you, showing each step as it goes.',
	},
	{
		q: 'What does it cost?',
		a: 'The kit is free. Running it on your laptop costs nothing at all. Deploying it costs the Cloudflare Workers Paid plan, because the database connection pool and the workflows the agents run on are paid features, plus a Postgres database — a free Neon tier is enough to start. The built-in AI is billed per call to your own Cloudflare account, with a free daily allowance, and you can switch it off or bring your own key.',
	},
	{
		q: 'Can I use it for a commercial product or for client work?',
		a: 'Yes. It is MIT licensed: build a product on it, charge for that product, keep your changes private, and you owe nothing and need not credit anyone. Take a copy, cut it loose from the original history, and it is your codebase.',
	},
	{
		q: 'Do I need a Cloudflare account?',
		a: 'To run it on your laptop, a free one — and only because the built-in AI runs on Cloudflare, so the first start asks you to log in. Run the bootstrap with --offline and no account is needed at all; chat and agents then wait for an AI key of your own. Deploying needs a Workers Paid plan.',
	},
	{
		q: 'Can it serve one organisation or many?',
		a: 'Both, from the same database. One setting switches between many organisations, each with its own members and roles, and a single organisation that everyone joins. You can change your mind later without touching the data or running a migration.',
	},
	{
		q: 'What is not included?',
		a: 'Billing and subscriptions are the big one — there is no Stripe integration, no plans and no metering of your customers. There is also no marketing site, no blog or CMS, and no mobile app. What is included is the platform underneath a product: tenancy, sign-in, roles, files, email, background jobs, realtime, dashboards, an AI layer and a command-line tool.',
	},
	{
		q: 'How is it different from other SaaS starter kits?',
		a: 'Three things. Multi-tenancy is the foundation rather than an add-on, so every row belongs to an organisation and the tests fail if one does not. The AI layer — chat, agents and search over your own documents — is built in and works on a fresh copy with no API key. And a copy keeps a link home: when the kit gains a release, one command ports it into your renamed app without recreating anything you deleted, so starting from a template does not mean falling behind it.',
	},
	{
		q: 'What does “agent-first” mean?',
		a: 'The kit is written to be worked on by a coding agent: a map at the root of the repository, rules that load with the files they apply to, a guide in every important folder, and one test gate that enforces them. Ask the agent to set up, rename or deploy the project and it follows the same steps a person would, showing each result as it goes.',
	},
]

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQS.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a },
	})),
}
---

<BaseLayout title={page.title} description={description} jsonLd={faqLd}>
	<!-- ====================================================== 1 · hero -->
	<header class="hero">
		<SkyScene />
		<div class="hero-inner wrap">
			<div class="hero-copy">
				<h1>Ship your product.<br /><span class="grad">Not the platform.</span></h1>
				<p class="lede">
					Rocketflare is a ready-made web app you copy and make your own. Out of the box it has
					sign-in, teams and permissions, an AI assistant that can read your documents, dashboards,
					a command-line tool, and a clean way to run background jobs — all on Cloudflare, over a normal Postgres
					database. Run it on your laptop in a couple of minutes; deploy it when you're ready.
				</p>
				<p class="engineer-line">One Cloudflare Worker · Hono · React · Postgres · MIT</p>
				<div class="hero-actions">
					<a href="/get-started/" class="btn btn-primary">
						Get it running
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</a>
					<a href="/tour/" class="btn btn-secondary">See what's inside</a>
				</div>
			</div>
		</div>
		<CloudDivider fill="var(--sky-mid)" />
	</header>

	<!-- ===================================================== 2 · proof -->
	<section class="proof" aria-labelledby="proof-title">
		<div class="wrap">
			<h2 id="proof-title" class="sr-only">What it looks like</h2>
			<div class="bleed reveal">
				<Screenshot
					light={homeLight}
					dark={homeDark}
					alt={`The Home page of a Rocketflare app, signed in as ${DEMO.ownerName}, owner of the demo organisation ${DEMO.org}`}
					url="localhost:3000"
					caption="This is the first thing you see: signed in, with a demo organisation already there."
					priority
					tilt
				/>
			</div>
			<ul class="thumbs reveal reveal-stagger">
				{thumbs.map((t) => (
					<li>
						<a href={`/tour/#${t.id}`}>
							<Screenshot light={t.light} dark={t.dark} alt={t.alt} frame="none" width={260} />
							<span class="thumb-label">{t.label} <span aria-hidden="true">→</span></span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ================================================= 3 · first run -->
	<section class="firstrun" id="first-run">
		<CloudDivider flip fill="var(--sky-bottom)" />
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					audience="builder"
					title="Running in about two minutes"
					lede="Run one script, ask your coding agent, or do it by hand. All three end in the same place: your browser, signed in."
				/>
			</div>
			<div class="split">
				<div class="split-chat reveal">
					<AgentChat agent={AGENT_NAME} turns={agentTurns} />
				</div>
				<div class="split-term reveal">
					<Terminal title="zsh" lines={terminalLines} expect={BOOTSTRAP_EXPECT} />
				</div>
			</div>
			<div class="strip reveal">
				<Steps
					direction="row"
					steps={[
						{ title: 'Get a copy', body: 'The installer clones it, makes the history yours from the first commit, and starts the bootstrap.', time: '10 s' },
						{ title: 'Bootstrap', body: `${numberWord(BOOTSTRAP_STEPS.length, { capital: true })} checked steps: toolchain, database, migrations, plugins, demo data. Or ask your agent.`, time: '2–3 min' },
						{ title: "You're in", body: `${APP_URL}, signed in as the demo owner.`, time: 'now' },
					]}
				/>
			</div>
			<p class="strip-more">
				<a href="/get-started/">Every path, step by step <span aria-hidden="true">→</span></a>
			</p>
		</div>
		<CloudDivider fill="var(--bg)" />
	</section>

	<!-- =============================================== 4 · what it does -->
	<section class="what">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					eyebrow="Out of the box"
					title="What is already built"
					lede="The parts every app needs and nobody wants to build twice — finished, tested, and already on the screen."
				/>
			</div>
			<div class="tri">
				{panels.map((p) => (
					<article class="tri-panel reveal">
						<Screenshot light={p.light} dark={p.dark} alt={p.alt} url={p.url} crop="top" width={360} />
						<h3>{p.title}</h3>
						<ul>
							{p.points.map((pt) => <li>{pt}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================== 5 · also included -->
	<!-- ========================================================= cli -->
	<section class="cli" id="cli">
		<div class="wrap">
			<div class="split cli-split">
				<div class="split-term reveal">
					<Terminal
						title="your terminal"
						lines={[
							{ cmd: 'pnpm cli login --server http://localhost:3001' },
							{ out: 'Opening the browser… signed in. Key stored in ~/.rocketflare/config.json', muted: true },
							{ cmd: 'pnpm cli whoami' },
							{ out: 'user    owner@example.test' },
							{ out: 'tenant  Acme Logistics (acme)' },
							{ out: 'key     rocketflare_Of8D…' },
							{ cmd: "pnpm cli members list --json | jq '.items[].email'" },
							{ out: '"owner@example.test"' },
							{ out: '"marcus.adeyemi@acme.example"' },
							{ out: '…', muted: true },
						]}
					/>
				</div>
				<div class="reveal">
					<SectionHead
						audience="builder"
						align="left"
						eyebrow="Also on the command line"
						title="A command line, for you and your agents"
						lede="Everything the app does in the browser it also does from the terminal — same routes, same rules, one API key."
					/>
					<ul class="cli-points">
						<li>Log in once from the terminal; it opens the browser, then keeps a key for your organisation.</li>
						<li>List people, keys and activity. Every command takes <code>--json</code>, so the output pipes into <code>jq</code> — or straight into a coding agent's hands.</li>
						<li>Add a command for your own feature in three files; the server, the browser and the CLI share one contract, so they cannot drift apart.</li>
					</ul>
					<a class="cli-link" href="/concepts/cli/">Behind it: the CLI concept →</a>
				</div>
			</div>
		</div>
	</section>

	<section class="also">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					title="Also included"
					lede={`Each of these has its own page among the ${conceptCount} concepts, with the reasoning behind it.`}
				/>
			</div>
			<ul class="also-grid reveal reveal-stagger">
				{also.map((a) => (
					<li class={`tone-${a.tone}`}>
						<a href={a.href}>
							<span class="chip"><ConceptIcon name={a.icon} /></span>
							<span class="also-text">
								<strong>{a.title}</strong>
								<span>{a.line}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ============================================== 6 · under the hood -->
	<section class="bg-band hood">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					audience="engineer"
					title="The stack, and why each piece is there"
					lede={`One Worker, one router, one database, one contract package — and every choice written down among the ${conceptCount} concepts so you can disagree with it on purpose.`}
				/>
			</div>
			<ol class="flow reveal" aria-label="How a request travels">
				<li class="node"><strong>Browser</strong><span>React, served by the Worker</span></li>
				<li class="arrow" aria-hidden="true">→</li>
				<li class="node"><strong>one Worker</strong><span>Hono · React</span></li>
				<li class="arrow" aria-hidden="true">→</li>
				<li class="node"><strong>Postgres</strong><span>Neon via Hyperdrive</span></li>
			</ol>
			<ul class="chips reveal reveal-stagger" aria-label="Cloudflare services the Worker uses">
				<li>Queues</li>
				<li>Workflows</li>
				<li>Durable Objects</li>
				<li>R2</li>
				<li>KV</li>
				<li>Workers AI</li>
			</ul>
			<p class="hood-link reveal">
				<a href="/concepts/">Read the concepts <span aria-hidden="true">→</span></a>
			</p>
		</div>
	</section>

	<!-- ============================================== 7 · who it is for -->
	<section class="who">
		<div class="wrap">
			<div class="who-grid">
				<div class="who-col reveal">
					<h2>I want to ship a product</h2>
					<ul>
						<li>You have an idea and a customer, and no wish to build sign-in again.</li>
						<li>You work with a coding agent and want it to know its way around from the first session.</li>
						<li>You want to deploy on a Sunday and not think about it on Monday.</li>
					</ul>
					<a class="who-link" href="/get-started/">Start here <span aria-hidden="true">→</span></a>
				</div>
				<div class="who-col reveal">
					<h2>I want to read the design</h2>
					<ul>
						<li>You want to know how organisations stay apart in one database, and what enforces it.</li>
						<li>You want to see how long work, realtime and AI fit on Cloudflare without a second service.</li>
						<li>You would rather disagree with a written decision than guess at an unwritten one.</li>
					</ul>
					<a class="who-link" href="/concepts/">Every decision, with its reasons <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<p class="who-more reveal"><a href="/who-is-it-for/">More on who it's for <span aria-hidden="true">→</span></a></p>
		</div>
	</section>

	<!-- ============================================ 8 · before you start -->
	<section class="before">
		<div class="wrap">
			<div class="reveal">
				<SectionHead title="Before you start" lede="Three things worth knowing, so nothing surprises you." />
			</div>
			<div class="notes reveal reveal-stagger">
				<Callout tone="blue" title="A Mac or Linux machine, with Docker running">
					<svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 18v3"/></svg>
					<p>Postgres runs in a container on your laptop, so Docker Desktop (or colima) has to be up. Windows works through WSL2, but that path is untested.</p>
				</Callout>
				<Callout tone="orange" title="A free Cloudflare login the first time it starts">
					<ConceptIcon slot="icon" name="cloud" />
					<p>The built-in AI runs on Workers AI, which always calls Cloudflare — 10 000 free neurons a day, then metered, billed to that account. Start with <code>--offline</code> and it is never asked for; chat and agents then wait for a key of your own.</p>
				</Callout>
				<Callout tone="yellow" title="Workers Paid to deploy">
					<ConceptIcon slot="icon" name="rocket" />
					<p>Running it on your laptop costs nothing. Deploying needs the paid Workers plan, because the database connection pool and the workflows the agents run on are paid features.</p>
				</Callout>
			</div>
		</div>
	</section>

	<!-- ============================================== 9 · questions -->
	<section class="faq">
		<div class="wrap">
			<div class="reveal">
				<SectionHead
					title="Questions people ask first"
					lede="Before you spend an evening on it — what it costs, what it does not do, and who it is for."
				/>
			</div>
			<div class="faq-list reveal reveal-stagger">
				{FAQS.map(({ q, a }) => (
					<div class="faq-item">
						<h3>{q}</h3>
						<p>{a}</p>
					</div>
				))}
			</div>
			<p class="faq-more">
				<a href="/costs/">What it costs to run</a>
				<span aria-hidden="true">·</span>
				<a href="/compare/">Build it yourself, or start from this</a>
			</p>
		</div>
	</section>

	<!-- ====================================================== 10 · cta -->
	<section class="cta bg-lift">
		<div class="wrap cta-inner reveal">
			<LogoMark size={48} class="cta-mark" />
			<h2>Everything above is already written.</h2>
			<p>Your first commit can be a feature.</p>
			<div class="cta-actions">
				<a href="/get-started/" class="btn btn-primary">Get started</a>
				<a href={GITHUB_URL} class="btn btn-ghost" target="_blank" rel="noopener">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
					GitHub
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.sr-only {
		position: absolute;
