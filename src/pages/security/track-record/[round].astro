---
/**
 * One round of the security track record: the runs in it (scope, coverage, agent calls), and per
 * release the number of findings fixed, by severity, and of hardening changes. Numbers only: no
 * individual finding or hardening change is published.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import FixedCounts from '../../../components/security/FixedCounts.astro'
import NotPublished from '../../../components/security/NotPublished.astro'
import RunsTable from '../../../components/security/RunsTable.astro'
import { ROUNDS, type Round } from '../../../data/security'

export function getStaticPaths() {
	return ROUNDS.map((r) => ({ params: { round: r.slug } }))
}

const round = ROUNDS.find((r) => r.slug === Astro.params.round) as Round
const others = ROUNDS.filter((r) => r.slug !== round.slug)
const title = `${round.title} — security track record — Rocketflare`
const description = `${round.summary} How many findings it confirmed are fixed, by severity and release, with the hardening shipped beside them.`
---
<BaseLayout title={title} description={description}>
	<header class="hero page-hero bg-sky">
		<div class="wrap">
			<a class="back" href="/security/track-record/"><span aria-hidden="true">←</span> Track record</a>
			<span class="eyebrow">Track record</span>
			<h1>{round.title}</h1>
			<p class="lede">{round.summary}</p>
		</div>
	</header>

	<section class="block">
		<div class="wrap">
			<RunsTable runs={round.runs} label={`${round.title}: runs`} />

			<h2>Fixed, by release</h2>
			<p class="note">
				{round.totals.findings} confirmed findings fixed in released versions
				({round.totals.high} high, {round.totals.medium} medium, {round.totals.low} low), and
				{round.totals.hardening} hardening changes: candidates the audit could not settle, usually
				because the answer needed a browser, a real identity provider or a real model, where the
				cautious fix was small enough to ship anyway.
				{round.runs.length > 1 && ' A finding both runs confirmed is counted once.'}
			</p>
			<FixedCounts fixed={round.fixed} label={`${round.title}: fixes by release`} />
			<p class="note"><NotPublished /></p>

			<nav class="others" aria-label="Other rounds">
				{others.map((r) => (
					<a href={r.path}>{r.title} <span aria-hidden="true">→</span></a>
				))}
				<a href="/security/">How the kit is audited <span aria-hidden="true">→</span></a>
			</nav>
		</div>
	</section>
</BaseLayout>

<style>
	.hero { border-block-end: 1px solid var(--border); }
	.hero .lede { max-inline-size: 70ch; }
	.back { display: block; inline-size: fit-content; margin-block-end: 1rem; font-size: 0.9rem; font-weight: 600; }
	.block { padding-block: 2.5rem 4.5rem; }
	h2 { margin-block: 2.6rem 0.4rem; }
	.note { margin-block: 0 1rem; font-size: 0.93rem; color: var(--text-muted); max-inline-size: 75ch; }
	.others { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; margin-block-start: 3rem; font-weight: 600; }
</style>
