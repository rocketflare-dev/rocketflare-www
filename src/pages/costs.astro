---
/**
 * What it costs to run: free on a laptop, small when first deployed, and the
 * few things that make the bill grow. No prices are quoted here; each line
 * links to the vendor's own pricing page, which is the one that stays current.
 * The page closes on the alternative: we operate the app for you.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHead from '../components/SectionHead.astro'
import ConceptIcon from '../components/ConceptIcon.astro'
import { pageByPath } from '../data/pages'
import { OPERATE_CONTACT_URL } from '../data/site'

const page = pageByPath('/costs/')
if (!page) throw new Error('Page not in the registry: /costs/')

interface Line {
	service: string
	icon: string
	tone: 'blue' | 'green' | 'orange' | 'purple'
	body: string
	url: string
}

const lines: Line[] = [
	{
		service: 'Cloudflare',
		icon: 'cloud',
		tone: 'orange',
		body: 'The Workers Paid plan. The one bill you always have, because the agents run on Workflows.',
		url: 'https://developers.cloudflare.com/workers/platform/pricing/',
	},
	{
		service: 'Postgres',
		icon: 'database',
		tone: 'blue',
		body: 'Neon, billed by compute and storage. It scales to zero, so a quiet app costs little.',
		url: 'https://neon.com/docs/introduction/plans',
	},
	{
		service: 'Email',
		icon: 'inbox',
		tone: 'green',
		body: 'Resend, for sign-in links, invitations and notifications. Billed by volume.',
		url: 'https://resend.com/pricing',
	},
	{
		service: 'AI',
		icon: 'sparkles',
		tone: 'purple',
		body: 'Workers AI by default, or your own Anthropic or OpenAI key. Billed by tokens.',
		url: 'https://developers.cloudflare.com/workers-ai/platform/pricing/',
	},
]

const growth = [
	{
		icon: 'sparkles',
		title: 'AI use',
		body: 'The biggest driver by far. An agent that reads four documents to answer a question pays for every passage it reads. The kit records tokens and cost per organisation, so you can see it.',
	},
	{
		icon: 'database',
		title: 'Database time',
		body: 'Postgres is billed while it is awake. Users in one timezone keep it cheap; work that runs around the clock keeps it busy.',
	},
	{
		icon: 'document',
		title: 'Files',
		body: 'Uploads are stored in R2 and billed by the gigabyte, with no fees for reading them back. A portal full of customer documents adds up.',
	},
	{
		icon: 'users',
		title: 'Traffic',
		body: 'The Paid plan includes a large allowance of requests. A B2B app rarely gets through it, and if yours does, that is a good problem.',
	},
]

const runs = [
	{ title: 'Hosting', body: 'Deployed and kept running on Cloudflare.' },
	{ title: 'Security and patching', body: 'Updates to the kit, its dependencies and the platform applied as they land.' },
	{ title: 'Incident response', body: 'Monitoring, alerting and a team that responds when something goes wrong.' },
	{ title: 'Upgrades', body: 'Each new Rocketflare release applied to your app.' },
	{ title: 'Support', body: 'Optionally, a branded first line of support for your users.' },
]
---
<BaseLayout title={page.title} description={page.description} noindex={!page.ready}>
	<header class="hero page-hero bg-sky">
		<div class="wrap">
			<span class="eyebrow">What it costs</span>
			<h1>Starts small, grows with your app</h1>
			<p class="lede">
				On your laptop it is free. Deployed, it needs a paid Cloudflare account, and the rest of the
				bill follows how much the app is used. Or you can hand the whole thing to us.
			</p>
			<div class="paths">
				<a class="path" href="#start">
					<span class="path-label">On your laptop</span>
					<strong class="path-price">Free</strong>
					<span class="path-body">No accounts, no keys and no card. Build your whole first feature for nothing.</span>
				</a>
				<a class="path" href="#start">
					<span class="path-label">Deployed by you</span>
					<strong class="path-price">A paid Cloudflare plan</strong>
					<span class="path-body">Plus Postgres, email and AI, each billed by use. And your team’s time to run it.</span>
				</a>
				<a class="path path-us" href="#run-it">
					<span class="path-label">Run by us</span>
					<strong class="path-price">We operate it for you</strong>
					<span class="path-body">Hosting, security patching, incident response and support, from a team that has run SaaS at global scale.</span>
					<span class="path-cta">How it works <span aria-hidden="true">↓</span></span>
				</a>
			</div>
		</div>
	</header>

	<section class="block" id="start">
		<div class="wrap">
			<SectionHead
				align="left"
				eyebrow="Starting small"
				title="Four lines on the bill"
				lede="Cloudflare is the one you always pay. The other three are billed by use, so a new app with a handful of users costs very little."
			/>
			<div class="line-grid">
				{lines.map((l) => (
					<article class={`line tone-${l.tone}`}>
						<span class="chip"><ConceptIcon name={l.icon} /></span>
						<h3>{l.service}</h3>
						<p>{l.body}</p>
						<a href={l.url} target="_blank" rel="noopener">Their pricing <span aria-hidden="true">↗</span></a>
					</article>
				))}
			</div>
			<p class="laptop-note">
				Nothing on this list applies on your laptop. Postgres runs in a container, sign-in links print
				to the terminal, and <code>--offline</code> turns off the one call out to Cloudflare.
			</p>
		</div>
	</section>

	<section class="block bg-band">
		<div class="wrap">
			<SectionHead
				align="left"
				eyebrow="Scaling up"
				title="What makes it grow"
				lede="In rough order of how likely each one is to move the number."
			/>
			<ol class="growth">
				{growth.map((g) => (
					<li>
						<span class="chip"><ConceptIcon name={g.icon} /></span>
						<div>
							<h3>{g.title}</h3>
							<p>{g.body}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="block" id="run-it">
		<div class="wrap">
			<div class="run tone-orange">
				<div class="run-intro">
					<span class="eyebrow">A service we offer</span>
					<h2>Or let us run it for you</h2>
					<p class="run-lede">
						The bill above is the infrastructure. Someone also has to patch it, watch it, upgrade it
						and respond when something breaks. That can be us.
					</p>
					<p>
						Our team has deep experience running global-scale B2C and B2B SaaS, so your app gets the
						security and incident response you would expect from a large provider.
					</p>
					<a class="btn btn-primary" href={OPERATE_CONTACT_URL}>Talk to us about running your app</a>
				</div>
				<ul class="run-list">
					{runs.map((r) => (
						<li>
							<h3>{r.title}</h3>
							<p>{r.body}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="block next">
		<div class="wrap next-row">
			<div>
				<h2>Try it before you pay anything</h2>
				<p>The local run is the whole app with demo data in it, and it takes about two minutes.</p>
			</div>
			<a class="btn btn-ghost" href="/get-started/">Get it running locally <span aria-hidden="true">→</span></a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero { border-bottom: 1px solid var(--border); }
	.hero .lede { max-width: 70ch; }
	.block { padding: 4rem 0; }

	/* ------------------------------------------------------------- paths -- */
	.paths {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
		margin-top: 2.4rem;
	}
	.path {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.4rem 1.5rem;
		border: 1px solid var(--border-bright);
		border-radius: 18px;
		background: var(--card);
		box-shadow: var(--shadow-sm);
		color: var(--text);
		transition: transform 0.18s ease, border-color 0.18s ease;
	}
	.path:hover { text-decoration: none; transform: translateY(-3px); border-color: var(--blue); }
	.path-label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.path-price { font-size: 1.35rem; line-height: 1.25; color: var(--text-bright); letter-spacing: -0.01em; }
	.path-body { font-size: 0.92rem; color: var(--text-muted); }
	.path-us { border: 2px solid var(--orange); box-shadow: var(--shadow); }
	.path-us:hover { border-color: var(--orange); }
	.path-us .path-label { color: var(--orange-ink); }
	.path-cta { margin-top: auto; padding-top: 0.5rem; font-weight: 700; color: var(--orange-ink); }

	/* ------------------------------------------------------------- chips -- */
	.chip {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 13px;
		background: var(--tint);
		color: var(--accent);
	}

	/* ------------------------------------------------------------- lines -- */
	.line-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem; }
	.line {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--card);
		box-shadow: var(--shadow-sm);
	}
	.line h3 { margin: 0.9rem 0 0.35rem; font-size: 1.1rem; }
	.line p { color: var(--text-muted); font-size: 0.93rem; margin: 0 0 1rem; }
	.line a { margin-top: auto; font-size: 0.88rem; font-weight: 600; }
	.laptop-note { margin: 1.6rem 0 0; color: var(--text-muted); font-size: 0.93rem; }

	/* ------------------------------------------------------------ growth -- */
	.growth {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 3rem;
	}
	.growth li { display: flex; gap: 1rem; align-items: flex-start; }
	.growth .chip { --tint: color-mix(in srgb, var(--band-ink) 10%, transparent); --accent: var(--orange); }
	.growth h3 { margin: 0 0 0.3rem; font-size: 1.1rem; }
	.growth p { margin: 0; color: var(--band-muted); }

	/* --------------------------------------------------------------- run -- */
	.run {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
		padding: 2.6rem 3rem;
		border: 2px solid var(--orange);
		border-radius: 24px;
		background:
			radial-gradient(700px 320px at 0% 0%, var(--tint), transparent 70%),
			var(--card);
		box-shadow: var(--shadow);
	}
	.run .eyebrow { color: var(--accent-ink); }
	.run h2 { margin-bottom: 0.7rem; }
	.run-intro p { color: var(--text-muted); }
	.run-intro .run-lede { font-size: 1.2rem; line-height: 1.45; color: var(--text-bright); font-weight: 600; }
	.run-intro .btn { margin-top: 0.6rem; }
	.run-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
	.run-list li { padding-left: 1rem; border-left: 3px solid var(--orange); }
	.run-list h3 { font-size: 1.05rem; margin: 0 0 0.15rem; }
	.run-list p { color: var(--text-muted); margin: 0; font-size: 0.93rem; }

	/* -------------------------------------------------------------- next -- */
	.next { padding-top: 1rem; padding-bottom: 5rem; }
	.next-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; }
	.next h2 { margin-bottom: 0.3rem; }
	.next p { color: var(--text-muted); margin: 0; }

	@media (max-width: 1000px) {
		.line-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 860px) {
		.paths, .growth, .run { grid-template-columns: minmax(0, 1fr); }
		.run { padding: 2rem 1.6rem; gap: 2rem; }
	}
	@media (max-width: 560px) {
		.line-grid { grid-template-columns: minmax(0, 1fr); }
	}
</style>
