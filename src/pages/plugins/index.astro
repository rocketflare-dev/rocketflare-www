---
/**
 * The first-party plugin catalogue. One card per entry in src/data/plugins.ts —
 * that file is the only place a plugin is described, so the tour, the personas
 * and this page cannot drift apart.
 *
 * Deliberately not a directory of third-party plugins: a plugin runs inside
 * your Worker with your database connection, so the honest position is
 * first-party only, said out loud rather than implied by an empty list.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import CloudDivider from '../../components/CloudDivider.astro'
import Callout from '../../components/Callout.astro'
import { pageByPath } from '../../data/pages'
import { PLUGINS, PLUGIN_COUNT, pluginPath } from '../../data/plugins'
import { numberWord } from '../../data/concepts'

const page = pageByPath('/plugins/')
if (!page) throw new Error('Page not in the registry: /plugins/')

/** What the search matches: name, id, summary, what it adds (tags stripped), skills and needs. */
const searchText = (p: (typeof PLUGINS)[number]) =>
	[p.id, p.label, p.summary, ...p.adds, ...(p.skills ?? []), ...(p.requires ?? [])]
		.join(' ')
		.replace(/<[^>]+>/g, ' ')
		.toLowerCase()
const cards = PLUGINS.map((p) => ({ p, text: searchText(p) }))
---
<BaseLayout title={page.title} description={page.description} noindex={!page.ready}>
	<header class="plugins-hero page-hero">
		<div class="wrap">
			<div class="hero-copy">
				<span class="eyebrow">Plugins · {numberWord(PLUGIN_COUNT)} first-party</span>
				<h1>Capabilities you copy in</h1>
				<p class="lede">
					A Rocketflare plugin is a git repository copied into your application — never an npm
					package. Its code lands as ordinary source, renamed into your own vocabulary on the way
					in, and deleting its folders takes it back out. Here is what is published today, what
					each one adds, and the one command that installs it.
					<a href="/concepts/plugins/">How the seam works →</a>
				</p>
			</div>
		</div>
		<CloudDivider fill="var(--bg)" />
	</header>

	<section class="catalogue" aria-labelledby="catalogue-title">
		<div class="wrap">
			<h2 id="catalogue-title" class="visually-hidden">The plugins</h2>
			<div class="search">
				<label for="plugin-search">Search plugins</label>
				<input
					id="plugin-search"
					type="search"
					placeholder="Name, feature or skill — e.g. calendar, cubes, search"
					autocomplete="off"
					spellcheck="false"
				/>
				<p class="search-count" aria-live="polite" id="plugin-search-count">{PLUGIN_COUNT} plugins</p>
			</div>
			<ul class="grid" role="list">
				{cards.map(({ p, text }, i) => (
					<li id={p.id} class:list={['pcard', 'reveal', i % 2 === 1 ? 'tone-cyan' : 'tone-green']} data-search={text}>
						<span class="eyebrow">
							{p.shipsAs === 'installed'
								? 'Installed by default'
								: p.shipsAs === 'vendored'
									? 'Ships in the kit'
									: 'Add it when you need it'}
						</span>
						<h3><a class="card-link" href={pluginPath(p)}>{p.label}</a></h3>
						<p class="summary">{p.summary}</p>
						<ul class="badges" role="list" aria-label={`${p.label} at a glance`}>
							<li><code>{p.version}</code></li>
							<li>kit ≥ <code>{p.minKit}</code></li>
							{p.requires?.map((r) => <li class="needs">needs <code>{r}</code></li>)}
							{p.skills && <li>{p.skills.length} {p.skills.length === 1 ? 'skill' : 'skills'}</li>}
						</ul>
					</li>
				))}
			</ul>
			<p class="no-match" hidden>No plugin matches that. Try a broader word, or <a href="/concepts/plugins/">read how plugins work</a>.</p>
		</div>
	</section>

	<script>
		// Filters the cards as you type. Without JS the input is hidden and every card shows.
		const input = document.querySelector<HTMLInputElement>('#plugin-search')
		const count = document.querySelector('#plugin-search-count')
		const cards = [...document.querySelectorAll<HTMLElement>('.grid > .pcard')]
		const none = document.querySelector<HTMLElement>('.no-match')
		const apply = () => {
			const words = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean)
			let shown = 0
			for (const card of cards) {
				const hit = words.every((w) => (card.dataset.search ?? '').includes(w))
				card.hidden = !hit
				if (hit) shown++
			}
			if (count) count.textContent = words.length ? `${shown} of ${cards.length} plugins` : `${cards.length} plugins`
			if (none) none.hidden = shown > 0
		}
		input?.addEventListener('input', apply)
		apply()
	</script>

	<section class="after">
		<div class="wrap-narrow">
			<Callout tone="yellow" title="First-party only, and that is a position rather than a stage">
				<p>
					A plugin runs inside your Worker with your database connection. There is no sandbox that
					would make that otherwise, so installing one is as trusting as merging a pull request.
					Every command prints its plan and stops until you re-run it with <code>--apply</code>, and
					the published set stays code the kit's own authors wrote — instead of a directory that
					implies a review process nobody is running.
				</p>
			</Callout>
			<h2>Writing one of your own</h2>
			<p>
				A plugin is a repository with a manifest, three directories and four entry files. The kit
				ships the reference one in its own tree so you can read a small, complete example before
				writing anything: a table, a gated route, a job, an agent tool, a page, two commands and its
				own tests. Point <code>pnpm plugin add</code> at a local path and it installs from there,
				which is the authoring loop.
			</p>
			<p class="after-links">
				<a class="btn btn-primary" href="/concepts/plugins/">Read the concept</a>
				<a class="btn btn-secondary" href="/get-started/">Get the kit running</a>
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.plugins-hero {
		position: relative;
		padding-bottom: 7rem;
		background: linear-gradient(180deg, var(--sky-top), var(--sky-mid) 60%, var(--bg));
	}

	.catalogue { padding: 0 0 4rem; background: var(--bg); }
	.visually-hidden {
		position: absolute; width: 1px; height: 1px; overflow: hidden;
		clip: rect(0 0 0 0); white-space: nowrap;
	}

	.search { display: grid; gap: 0.45rem; max-width: 36rem; margin: 0 0 1.8rem; }
	.search label { font-weight: 600; }
	.search input {
		font: inherit;
		padding: 0.7rem 0.95rem;
		border-radius: 12px;
		border: 1px solid var(--border-bright);
		background: var(--card);
		color: var(--text);
	}
	.search input::placeholder { color: var(--text-muted); }
	.search-count { margin: 0; font-size: 0.88rem; color: var(--text-muted); }
	:global(html:not(.js)) .search { display: none; }

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
		gap: 1.2rem;
	}
	.pcard {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--card);
		border: 1px solid var(--border);
		border-top: 4px solid var(--accent);
		border-radius: 16px;
		padding: 1.2rem 1.3rem 1.1rem;
		box-shadow: var(--shadow-sm);
		scroll-margin-top: 5rem;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.pcard[hidden] { display: none; }
	.pcard:hover { border-color: var(--border-bright); transform: translateY(-2px); }
	.pcard:focus-within { border-color: var(--accent); }
	.pcard h3 { margin: 0.25rem 0 0.45rem; font-size: 1.2rem; }
	/* The whole card is the link's target; the link itself stays the one focusable thing. */
	.card-link { color: var(--text-bright); text-decoration: none; }
	.card-link::after { content: ''; position: absolute; inset: 0; border-radius: 16px; }
	.card-link:focus-visible { outline: none; }
	.pcard:has(.card-link:focus-visible) { outline: 3px solid var(--orange); outline-offset: 3px; }
	.summary {
		margin: 0 0 0.9rem;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.badges { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.badges li {
		font-size: 0.78rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--card-alt);
		border: 1px solid var(--border);
		color: var(--text);
	}
	.badges code { font-size: 0.76rem; background: none; padding: 0; }
	.badges .needs { border-color: var(--accent); }
	.no-match { color: var(--text-muted); }

	.after { padding: 1rem 0 5rem; background: var(--bg); }
	.after h2 { margin-top: 2.4rem; }
	.after-links { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }

</style>
