			{ k: 'Pricing', v: 'Free for 2 builders; paid from $23 per builder a month' },
			{ k: 'Licence', v: 'AGPL-3.0' },
			{ k: 'SSO', v: 'Supported; tier unclear on the pricing page' },
			{ k: 'Organisations for your customers', v: 'Not described' },
		],
	},
	{
