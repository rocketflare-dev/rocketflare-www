			{ k: 'SSO', v: 'Enterprise only' },
			{ k: 'Organisations for your customers', v: 'Not described' },
		],
	},
]

const table = {
	columns: ['Retool', 'Appsmith', 'Budibase', 'ToolJet', 'Superblocks', 'Rocketflare'],
	rows: [
		{ row: 'How you build', cells: ['Visual editor, plus AI', 'Visual editor', 'Visual editor, plus agents', 'Visual editor, plus AI', 'AI generates React', 'Code, written with Claude Code or Codex'] },
		{ row: 'Licence', cells: ['Proprietary', 'Apache-2.0', 'GPLv3 and BSL', 'AGPL-3.0', 'Proprietary', 'MIT'] },
		{ row: 'Self-hosting', cells: ['Enterprise', 'Yes', 'Yes', 'Yes', 'Enterprise', 'It always runs in your account'] },
		{ row: 'Pricing shape', cells: ['Per builder and user', 'Per user', 'Base plus per user', 'Per builder', 'Per plan and app', 'Cloudflare, Postgres and AI usage'] },
		{ row: 'Enterprise SSO', cells: ['Enterprise', 'Enterprise', 'OIDC free, SAML Enterprise', 'Unclear by tier', 'Enterprise', 'Any OIDC issuer, included'] },
		{ row: 'Customers as organisations', cells: ['Not described', 'Not described', 'Not described', 'Not described', 'Not described', 'Built in, with isolation tests'] },
		{ row: 'Agents that wait for approval', cells: ['Humans in decisions', 'No', 'Approval policies', 'Not described', 'Not described', 'Durable runs: approval, choice, input or form'] },
		{ row: 'Runs without the vendor', cells: ['No', 'On the open-source platform', 'On the open-source platform', 'On the open-source platform', 'React export; backend not documented', 'Yes: it is your code'] },
	],
}

const differences = [
	{
		title: 'No per-user bill',
		body: 'A Rocketflare app costs what it uses on Cloudflare, your Postgres and your AI provider. Adding the rest of the company, or a thousand customers, does not add a seat price. Single sign-on is included rather than an Enterprise feature.',
		icon: 'users',
		tone: 'green' as const,
	},
	{
		title: 'Room to become a product',
		body: 'Internal tools have a habit of being shown to customers. Here every row already belongs to an organisation, signup can be open, invite-only or by approval, and a support role lets your team step into a customer’s organisation with a visible membership.',
		icon: 'building',
		tone: 'blue' as const,
	},
	{
		title: 'The screens your team asks for in month three',
		body: 'Invitations, roles, an activity log of who did what, feature flags per organisation, background jobs, dashboards over your data, and agents that stop for a person. All already written and tested.',
		icon: 'window',
		tone: 'cyan' as const,
	},
]

const pickThem = [
	{ who: 'You need admin screens over existing systems this week.', when: 'Retool, Appsmith or ToolJet connect to the database and API you already have and give you tables, forms and buttons in an afternoon. Rocketflare starts with its own database.' },
	{ who: 'The people building it will not write code.', when: 'Every builder here has a visual editor. Rocketflare is a codebase, even if a coding agent does most of the typing.' },
	{ who: 'You want free self-hosting and approval-heavy agents for one team.', when: 'Budibase’s community edition is free for unlimited users, and its agents have approval policies.' },
	{ who: 'A central IT team is governing hundreds of generated apps.', when: 'Superblocks and Retool Enterprise are built for that. Rocketflare is one app per repository.' },
]

const faqs = [
	{
		q: 'Is Rocketflare an alternative to Retool?',
		a: 'Yes, for internal tools that need to become products or that many people use. Retool charges per builder and per user, and SSO, Git source control and self-hosting are Enterprise features. A Rocketflare app is MIT-licensed code in your own Cloudflare account with SSO included, no per-user price, and organisations and roles ready for customers. Retool is quicker for admin screens over systems you already have.',
	},
	{
		q: 'Is Rocketflare an open-source alternative to Retool, like Appsmith or Budibase?',
		a: 'It is open source (MIT), but it is a different kind of thing. Appsmith, Budibase and ToolJet are open-source platforms with a visual editor, and your app runs on their runtime. Rocketflare is the app itself, as TypeScript you own, built with a coding agent instead of an editor.',
	},
	{
		q: 'Can a Rocketflare internal tool be opened to customers later?',
		a: 'Yes. It is multi-tenant from the first row: switching from one organisation to many is a setting, not a migration. Customers get their own members, roles, documents and dashboards, and a test fails the build if a query forgets which organisation it is for.',
	},
	{
		q: 'Does Rocketflare connect to our existing database?',
		a: 'Rocketflare has its own Postgres database, and you write the integrations as code, often with a coding agent. If the job is a screen over an existing database with no new data model, an internal tool builder is the faster route.',
	},
]

