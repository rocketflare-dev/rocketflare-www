import CompareLayout from '../../components/CompareLayout.astro'

const profiles = [
	{
		anchor: 'shipfast',
		lead: 'If you are looking for a ShipFast alternative because your product is sold to companies rather than individuals, Rocketflare starts where ShipFast stops: organisations, roles and single sign-on, plus an AI layer, for nothing.',
		what: 'ShipFast is a Next.js boilerplate for solo founders, built to get a landing page, sign-in and payments live quickly. It uses NextAuth with Google and magic links, MongoDB or Supabase for data, and Stripe or Lemon Squeezy for checkout. You pay once and get access to a private repository.',
		strong: 'Speed to a first sale for a consumer or single-user product: landing page, SEO and blog pages, checkout. It has a large and active community of people shipping with it.',
		stops: 'There are no teams, organisations or roles, no SSO, no background jobs and no AI features in the app. The site lists its last update around February 2026. The licence forbids redistributing the boilerplate, and does not say whether you may open-source an app built on it.',
		facts: [
			{ k: 'Price', v: 'One-time, from $199 at the time of checking' },
			{ k: 'Licence', v: 'Personal or team; non-transferable' },
			{ k: 'Stack', v: 'Next.js, NextAuth, MongoDB or Supabase' },
			{ k: 'Organisations and roles', v: 'Not included' },
		],
	},
