---
/**
 * KITCHEN SINK — a scratch page that renders every new component with sample
 * props so they can be eyeballed in both themes (use the nav toggle). It is
 * `noindex`, left out of the sitemap and of src/data/pages.ts, and is deleted
 * before the overhaul branch merges.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHead from '../components/SectionHead.astro'
import Callout from '../components/Callout.astro'
import Steps from '../components/Steps.astro'
import Terminal from '../components/Terminal.astro'
import AgentChat from '../components/AgentChat.astro'
import Tabs from '../components/Tabs.astro'
import Screenshot from '../components/Screenshot.astro'
import DiagramStack from '../components/DiagramStack.astro'
import DiagramCascade from '../components/DiagramCascade.astro'
import DiagramSteps from '../components/DiagramSteps.astro'
import DiagramParity from '../components/DiagramParity.astro'
import DiagramSequence from '../components/DiagramSequence.astro'
import ConceptIcon from '../components/ConceptIcon.astro'
import light from '../assets/screens/placeholder.light.png'
import dark from '../assets/screens/placeholder.dark.png'

const icons = ['building', 'key', 'layers', 'database', 'bolt', 'inbox', 'window', 'chart', 'sparkles', 'cloud', 'terminal', 'link', 'robot', 'compass', 'document', 'search', 'users', 'gauge', 'rocket']
const tones = ['blue', 'purple', 'orange', 'cyan', 'red', 'green', 'yellow']
---
<BaseLayout title="Kitchen sink — Rocketflare components" description="Every component with sample props. Not a page of the site." noindex>
	<section class="bg-sky k">
		<div class="wrap">
			<SectionHead eyebrow="Kitchen sink" title="Every new component, on one page" lede="Toggle the theme in the nav; every token below must hold up in both. This page is deleted before merge." />
			<p class="measure">Type steps: <span style="font-size: var(--step-1)">step-1</span> · <span style="font-size: var(--step-2)">step-2</span> · <span style="font-size: var(--step-3)">step-3</span> · <span style="font-size: var(--step-4)">step-4</span></p>
		</div>
	</section>

	<section class="k">
		<div class="wrap">
			<SectionHead audience="builder" eyebrow="SectionHead" title="Left-aligned, with an audience tag" lede="The eyebrow and the tag sit on one line; the lede caps at 62ch." align="left" />
			<SectionHead audience="engineer" title="Centred, engineer audience, no eyebrow" />
			<h3>Tones and icons</h3>
			<div class="row">
				{tones.map((t) => <span class={`chip tone-${t}`}><ConceptIcon name="rocket" /></span>)}
			</div>
			<div class="row">
				{icons.map((i) => <span class="chip tone-blue" title={i}><ConceptIcon name={i} /></span>)}
			</div>
			<div class="row">
				<a class="btn btn-primary" href="#">Primary</a>
				<a class="btn btn-secondary" href="#">Secondary</a>
				<a class="btn btn-ghost" href="#">Ghost</a>
			</div>
		</div>
	</section>

	<section class="bg-band k">
		<div class="wrap">
			<SectionHead eyebrow="bg-band" title="A dark band section" lede="Headings and ledes pick up --band-ink / --band-muted; links go cyan." />
			<p>Body text in the band. <a href="#">A link.</a> <code>inline code</code></p>
		</div>
	</section>

	<section class="k">
		<div class="wrap-narrow">
			<h3>Callout</h3>
			<Callout tone="blue" title="What about Cloudflare?">
				<p>Local development emulates every binding except one. A <strong>free account is enough</strong>.</p>
			</Callout>
			<Callout tone="orange" title="Costs money">
				<svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v12"/><path d="M15.5 9.5a3.5 3 0 0 0-7 0c0 4 7 2 7 6a3.5 3 0 0 1-7 0"/></svg>
				<p>Every Workers AI call bills the account that owns the Worker.</p>
				<p>Ten thousand free neurons a day, then metered.</p>
			</Callout>
			<Callout tone="yellow" title="Heads up"><p>Yellow tone.</p></Callout>
			<Callout tone="green" title="All good"><p>Green tone.</p></Callout>

			<h3>Steps — row, numbered</h3>
			<Steps steps={[
				{ title: 'Clone it', body: '<code>git clone</code> and <code>cd</code> in.', time: '1 min' },
				{ title: 'Ask your agent', body: '“Help me set up this project”', time: '5 min' },
				{ title: 'Sign in', body: 'The magic link is printed in your terminal.', time: '10 s' },
			]} />
			<h3>Steps — column, dots</h3>
			<Steps direction="column" numbered={false} steps={[
				{ title: 'Routes enqueue' },
				{ title: 'The queue runs it', body: 'Poison messages are acked; errors retry with backoff.' },
				{ title: 'The socket nudges', body: 'The UI re-queries.' },
			]} />

			<h3>Terminal</h3>
			<Terminal
				title="zsh — myapp"
				lines={[
					{ cmd: 'git clone https://github.com/rocketflare-dev/rocketflare.git myapp && cd myapp' },
					{ cmd: 'corepack enable && pnpm install' },
					{ out: 'Progress: resolved 1204, reused 1204, downloaded 0, added 1204', muted: true },
					{ cmd: 'pnpm dev:db:up && pnpm db:migrate && pnpm seed' },
					{ out: 'Applied 5 migrations', ok: true },
					{ out: 'Seeded demo tenant, 3 users, 1 API key', ok: true },
				]}
				expect="pnpm dev → http://localhost:3000"
			/>

			<h3>AgentChat (type-in)</h3>
			<AgentChat typeIn agent="Claude Code" turns={[
				{ who: 'you', text: 'Help me set up this project' },
				{ who: 'agent', text: 'Reading CLAUDE.md and SETUP.md. Working through Part 1 step by step:', checks: ['Node 24, pnpm 10, Docker running', 'Dependencies installed', 'Postgres up, migrations applied, demo tenant seeded', 'wrangler dev on :3001, vite on :3000'] },
				{ who: 'agent', text: 'You are signed in as owner@demo.test. Want me to run the rename checklist next?' },
			]} />

			<h3>Tabs</h3>
			<Tabs tabs={[{ id: 'agent', label: 'With your agent' }, { id: 'hand', label: 'By hand' }]}>
				<Fragment slot="agent">
					<p>Open the repository in your coding agent and ask it to set the project up.</p>
				</Fragment>
				<Fragment slot="hand">
					<Terminal lines={[{ cmd: 'pnpm install' }, { cmd: 'pnpm dev' }]} />
				</Fragment>
			</Tabs>
		</div>
	</section>

	<section class="bg-lift k">
		<div class="wrap">
			<h3>Screenshot — browser frame, priority, tilt</h3>
			<Screenshot light={light} dark={dark} alt="The Organisation Overview dashboard" url="app.example.com/analytics" caption="A caption under the frame." priority tilt />
			<h3>Screenshot — no frame, crop top, 640 wide</h3>
			<Screenshot light={light} dark={dark} alt="The People page" frame="none" crop="top" width={640} />
		</div>
	</section>

	<section class="k">
		<div class="wrap-narrow">
			<h3>DiagramStack</h3>
			<DiagramStack describedBy="k-stack" layers={[
				{ label: 'onError', note: 'every failure gets the envelope' },
				{ label: 'request logger + config' },
				{ label: 'security headers · body limit · CORS · CSRF' },
				{ label: 'database', note: 'one client per request' },
				{ label: 'routes', note: 'thin; enqueue, never run' },
			]} />
			<table id="k-stack"><tr><th>Layer</th><th>Note</th></tr><tr><td>onError</td><td>every failure gets the envelope</td></tr><tr><td>…</td><td></td></tr></table>

			<h3>DiagramCascade (two columns)</h3>
			<DiagramCascade describedBy="k-cascade" primaryTitle="chat" secondaryTitle="embeddings"
				tiers={[
					{ label: 'agent_models', detail: 'per-agent assignment' },
					{ label: "tenant's default provider", detail: 'ai_configs' },
					{ label: 'ANTHROPIC_API_KEY', detail: 'platform' },
					{ label: 'Workers AI', detail: 'zero key' },
					{ label: '503 ai_not_configured' },
				]}
				secondary={[
					{ label: 'tenant default', detail: 'scope = embeddings' },
					{ label: 'Workers AI', detail: 'bge-m3' },
					{ label: 'EMBEDDINGS_API_KEY' },
					{ label: '503' },
				]}
			/>
			<ol id="k-cascade"><li>agent_models</li><li>tenant default</li><li>platform key</li><li>Workers AI</li><li>503</li></ol>

			<h3>DiagramSteps (retry loop)</h3>
			<DiagramSteps describedBy="k-steps" steps={['claim', 'execute', 'finish']} retryFrom={1} retryLabel="retry re-claims" note="Every terminal write is WHERE status IN (queued, running)" />
			<ol id="k-steps"><li>claim</li><li>execute (retries 2)</li><li>finish</li></ol>

			<h3>DiagramParity</h3>
			<DiagramParity describedBy="k-parity" leftTitle="wrangler.toml" rightTitle="wrangler.staging.toml"
				shared={['binding names', 'class_name', 'compatibility_date', '[triggers] crons']}
				differ={[
					{ key: 'name', left: 'rocketflare', right: 'rocketflare-staging' },
					{ key: 'APP_ENV', left: 'production', right: 'staging' },
					{ key: 'workflows.name', left: 'rocketflare-agent-run', right: '…-agent-run-staging' },
				]}
			/>
			<table id="k-parity"><tr><th>Key</th><th>production</th><th>staging</th></tr><tr><td>name</td><td>rocketflare</td><td>rocketflare-staging</td></tr></table>

			<h3>DiagramSequence</h3>
			<DiagramSequence describedBy="k-seq" actors={['CLI', 'Browser', 'Server']} messages={[
				{ from: 0, to: 0, label: 'listen on 127.0.0.1:8765' },
				{ from: 0, to: 1, label: 'open /auth/cli?redirect_uri=…' },
				{ from: 1, to: 2, label: 'sign in, pick a tenant' },
				{ from: 2, to: 1, label: '302 → ?key=&tenant_id=' },
				{ from: 1, to: 0, label: 'GET /callback?key=…' },
				{ from: 0, to: 2, label: 'GET /api/me (verify)' },
			]} />
			<ol id="k-seq"><li>The CLI listens on a loopback port.</li><li>…</li></ol>
		</div>
	</section>
</BaseLayout>

<style>
	.k { padding: 3rem 0; border-bottom: 1px solid var(--border); }
	.k h3 { margin-top: 2.4rem; }
	.row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1rem; }
	.chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 13px;
		background: var(--tint);
		color: var(--accent);
	}
	table { border-collapse: collapse; font-size: 0.85rem; margin: 0.8rem 0 0; }
	td, th { border-bottom: 1px solid var(--border); padding: 0.3rem 0.6rem; text-align: left; }
</style>
