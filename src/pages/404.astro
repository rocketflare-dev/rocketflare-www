---
/**
 * The not-found page. `wrangler.jsonc` serves it with a 404 status for any path with no asset
 * behind it (`assets.not_found_handling`), so the Worker's `env.ASSETS.fetch` returns it too.
 *
 * The sky is the rocket backdrop from Rocketflare Launch's sign-in page, ported down to one small
 * script: twinkling stars, a rocket that chases the pointer (and loops a lazy figure-eight when the
 * pointer is still or over the copy), an exhaust trail, and fireworks on a click. Every colour is
 * read from the tokens on the section, and re-read on a theme switch. Without scripts the page is
 * the copy on a dark band; under reduced motion it paints the stars and a parked rocket once.
 *
 * `noindex`, not in `pages.ts` (it would reach the nav), and the sitemap leaves 404 pages out.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout
	title="Page not found — Rocketflare"
	description="This page drifted out of orbit. Head back to the Rocketflare home page, the tour or Get started."
	noindex
>
	<section class="lost bg-band" data-lost>
		<canvas aria-hidden="true"></canvas>
		<div class="wrap">
			<div class="copy" data-rocket-ignore>
				<span class="eyebrow">404 · off course</span>
				<h1>Houston, this page doesn't exist.</h1>
				<p class="lede">
					The rocket is fine. The address isn't: it may have moved, or it never made it off the
					launch pad. Steer the rocket around while you're here — click the sky for fireworks —
					then head somewhere real.
				</p>
				<div class="actions">
					<a href="/" class="btn btn-primary">Back to base</a>
					<a href="/get-started/" class="btn btn-secondary">Get started</a>
					<a href="/tour/" class="btn btn-ghost">Take the tour</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.lost {
		/* The palette the script reads: tokens only, so both themes work. */
		--r-star: var(--band-ink);
		--r-body: var(--band-ink);
		--r-nose: var(--yellow-bright);
		--r-outline: var(--band-bg);
		--r-window: var(--cyan);
		--r-fin: var(--red);
		--r-hot: var(--yellow-bright);
		--r-cool: var(--orange);
		position: relative;
		overflow: hidden;
		min-height: max(32rem, 78svh);
		display: grid;
		align-items: center;
		padding: 4rem 0;
	}
	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.wrap { position: relative; width: 100%; }
	.copy { max-width: 40rem; }
	h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin-bottom: 0.4em; }
	.lede { font-size: var(--step-1); color: var(--band-muted); max-width: 62ch; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
</style>

<script>
	type Spark = { x: number; y: number; vx: number; vy: number; life: number; size: number; hot: boolean }
	const section = document.querySelector<HTMLElement>('[data-lost]')
	const canvas = section?.querySelector('canvas')
	const ctx = canvas?.getContext('2d')
	if (section && canvas && ctx) {
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches
		const keys = ['star', 'body', 'nose', 'outline', 'window', 'fin', 'hot', 'cool'] as const
		let c = {} as Record<(typeof keys)[number], string>
		const readPalette = () => {
			const css = getComputedStyle(section)
			c = Object.fromEntries(keys.map((k) => [k, css.getPropertyValue(`--r-${k}`).trim()])) as typeof c
		}
		let w = 0, h = 0
		let stars: { x: number; y: number; d: number; p: number; s: number }[] = []
		const sparks: Spark[] = []
		const ptr = { x: 0, y: 0, on: false, at: 0 }
		const rk = { x: 0, y: 0, vx: 0, vy: 0, a: -Math.PI / 4 }
		const par = { x: 0, y: 0 }
		const shape = (path: [number, number][]) => {
			ctx.beginPath()
			for (const [x, y] of path) ctx.lineTo(x, y)
			ctx.closePath()
		}
		const body = () => {
			ctx.beginPath()
			ctx.moveTo(22, 0)
			ctx.bezierCurveTo(14, -10, -6, -9, -16, -6)
			ctx.lineTo(-16, 6)
			ctx.bezierCurveTo(-6, 9, 14, 10, 22, 0)
		}
		// The rocket points along +x, about 44px long, drawn at 1.7×.
		const rocket = (flicker: number) => {
			ctx.save()
			ctx.translate(rk.x, rk.y)
			ctx.rotate(rk.a)
			ctx.scale(1.7, 1.7)
			for (const [col, r, len] of [[c.cool, 6, 30], [c.hot, 3.5, 24]] as const) {
				ctx.fillStyle = col
				ctx.beginPath()
				ctx.moveTo(-16, -r)
				ctx.quadraticCurveTo(-len - flicker * (len / 3), 0, -16, r)
				ctx.fill()
			}
			ctx.lineWidth = 2.25
			ctx.lineJoin = 'round'
			ctx.strokeStyle = c.outline
			ctx.fillStyle = c.fin
			for (const s of [-1, 1]) {
				shape([[-6, 6 * s], [-17, 15 * s], [-15, 4 * s]])
				ctx.fill()
				ctx.stroke()
			}
			ctx.fillStyle = c.body
			body()
			ctx.fill()
			ctx.save()
			ctx.clip()
			ctx.fillStyle = c.nose
			ctx.fillRect(13, -12, 12, 24)
			ctx.restore()
			body()
			ctx.stroke()
			ctx.fillStyle = c.window
			ctx.beginPath()
			ctx.arc(4, 0, 3.6, 0, Math.PI * 2)
			ctx.fill()
			ctx.stroke()
			ctx.restore()
		}
		const dot = (x: number, y: number, r: number) => {
			ctx.beginPath()
			ctx.arc(x, y, r, 0, Math.PI * 2)
			ctx.fill()
		}
		const paint = (t: number) => {
			ctx.clearRect(0, 0, w, h)
			ctx.fillStyle = c.star
			for (const s of stars) {
				ctx.globalAlpha = (0.55 + 0.45 * s.d) * (still ? 1 : 0.625 + 0.375 * Math.sin(t * s.s + s.p))
				dot((((s.x + par.x * s.d * 40) % w) + w) % w, (((s.y + par.y * s.d * 40) % h) + h) % h, 0.7 + s.d * 1.3)
			}
			for (let i = sparks.length - 1; i >= 0; i--) {
				const s = sparks[i] as Spark
				s.x += s.vx
				s.y += s.vy
				s.vx *= 0.96
				s.vy *= 0.96
				s.life -= 0.025
				if (s.life <= 0) {
					sparks.splice(i, 1)
					continue
				}
				ctx.globalAlpha = s.life * 0.8
				ctx.fillStyle = s.hot ? c.hot : c.cool
				dot(s.x, s.y, s.size * s.life)
			}
			ctx.globalAlpha = 1
			rocket(still ? 0.5 : Math.random())
		}
		const resize = () => {
			const dpr = Math.min(devicePixelRatio || 1, 2)
			w = canvas.clientWidth
			h = canvas.clientHeight
			canvas.width = w * dpr
			canvas.height = h * dpr
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
			stars = Array.from({ length: Math.round((w * h) / 4000) }, () => ({
				x: Math.random() * w,
				y: Math.random() * h,
				d: 0.2 + Math.random() * 0.8,
				p: Math.random() * Math.PI * 2,
				s: 0.0015 + Math.random() * 0.0035,
			}))
			if (!rk.x) Object.assign(rk, { x: w * 0.78, y: h * 0.7 })
			if (still) paint(0)
		}
		readPalette()
		resize()
		addEventListener('resize', resize)
		// The theme toggle swaps data-theme on <html>: re-read the tokens (and repaint a still sky).
		new MutationObserver(() => (readPalette(), still && paint(0))).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		})
		const burst = (x: number, y: number, n: number, spread: number, base: number) => {
			for (let i = 0; i < n; i++) {
				const a = Math.random() * Math.PI * 2
				const v = 1 + Math.random() * spread
				sparks.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: 1, size: base + Math.random() * 2.5, hot: Math.random() > 0.5 })
			}
		}
		const local = (e: PointerEvent) => {
			const r = canvas.getBoundingClientRect()
			return [e.clientX - r.left, e.clientY - r.top] as const
		}
		const ignored = (e: PointerEvent) => e.target instanceof Element && !!e.target.closest('[data-rocket-ignore]')
		if (!still) {
			section.addEventListener('pointermove', (e) => {
				;[ptr.x, ptr.y] = local(e)
				ptr.on = !ignored(e)
				ptr.at = performance.now()
			})
			section.addEventListener('pointerleave', () => (ptr.on = false))
			section.addEventListener('pointerdown', (e) => ignored(e) || burst(...local(e), 40, 4, 1.5))
			const tick = (t: number) => {
				// Idle: a lazy figure-eight. Otherwise a damped spring towards the pointer, so it swoops.
				const idle = !ptr.on || t - ptr.at > 4000
				const tx = idle ? w / 2 + Math.sin(t * 0.0004) * w * 0.38 : ptr.x
				const ty = idle ? h / 2 + Math.sin(t * 0.0008) * h * 0.3 : ptr.y
				rk.vx = (rk.vx + (tx - rk.x) * 0.004) * 0.93
				rk.vy = (rk.vy + (ty - rk.y) * 0.004) * 0.93
				rk.x += rk.vx
				rk.y += rk.vy
				const speed = Math.hypot(rk.vx, rk.vy)
				if (speed > 0.15) {
					const d = Math.atan2(rk.vy, rk.vx) - rk.a
					rk.a += Math.atan2(Math.sin(d), Math.cos(d)) * 0.15
				}
				par.x -= rk.vx * 0.02 + 0.01
				par.y -= rk.vy * 0.02 - 0.02
				const tail = [rk.x - Math.cos(rk.a) * 34, rk.y - Math.sin(rk.a) * 34]
				for (let i = 0; i < 1 + Math.min(3, Math.floor(speed / 2)); i++) {
					const a = rk.a + (Math.random() - 0.5) * 0.8
					const v = 1 + Math.random() * 1.5
					sparks.push({
						x: tail[0] as number,
						y: tail[1] as number,
						vx: -Math.cos(a) * v + rk.vx * 0.3,
						vy: -Math.sin(a) * v + rk.vy * 0.3,
						life: 1,
						size: 2 + Math.random() * 3,
						hot: Math.random() > 0.4,
					})
				}
				paint(t)
				requestAnimationFrame(tick)
			}
			requestAnimationFrame(tick)
		}
	}
</script>
