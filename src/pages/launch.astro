---
/**
 * Rocketflare Launch — an overview for prospective users and investors.
 *
 * A deck that is also a page: full-height slides that scroll (snap is
 * `proximity`, so a slide taller than a phone still scrolls), dots on the right
 * that are plain anchors, and a small script for the arrow keys. Prints one
 * slide per page, so it doubles as a PDF.
 *
 * Shared by link only: `noindex`, not in the page registry (no nav, footer or
 * llms.txt entry) and listed in SITEMAP_EXCLUDED_PATHS (src/data/pages.ts).
 *
 * Every product claim here must be true of Launch as built — check
 * rocketflare-launch's docs/plans/README.md and CHANGELOG.md before editing.
 * What is not built says so.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMark from '../components/LogoMark.astro'
import SectionHead from '../components/SectionHead.astro'
import Screenshot from '../components/Screenshot.astro'
import Callout from '../components/Callout.astro'
import DiagramSteps from '../components/DiagramSteps.astro'
import DiagramSequence from '../components/DiagramSequence.astro'
import { LAUNCH_CONTACT_URL, LAUNCH_GITHUB_URL } from '../data/site'

import createLight from '../assets/screens/launch-create.light.png'
import createDark from '../assets/screens/launch-create.dark.png'
import sessionLight from '../assets/screens/launch-session.light.png'
import sessionDark from '../assets/screens/launch-session.dark.png'
import approvalLight from '../assets/screens/launch-approval.light.png'
import approvalDark from '../assets/screens/launch-approval.dark.png'
import auditLight from '../assets/screens/launch-audit.light.png'
import auditDark from '../assets/screens/launch-audit.dark.png'
import appLight from '../assets/screens/launch-app.light.png'
import appDark from '../assets/screens/launch-app.dark.png'

const slides = [
	{ id: 'cover', label: 'Rocketflare Launch' },
	{ id: 'problem', label: 'The problem' },
	{ id: 'idea', label: 'The idea' },
	{ id: 'how', label: 'How it works' },
	{ id: 'create', label: 'Create an app' },
	{ id: 'build', label: 'Build by chatting' },
	{ id: 'ship', label: 'Ship through the gate' },
	{ id: 'production', label: 'Production-grade' },
	{ id: 'control', label: 'IT stays in control' },
	{ id: 'yours', label: 'Yours, not ours' },
	{ id: 'stack', label: 'Why Cloudflare and Neon' },
	{ id: 'fleet', label: 'The fleet' },
	{ id: 'contrast', label: 'Versus the alternatives' },
	{ id: 'proof', label: 'Where it stands' },
	{ id: 'model', label: 'How it makes money' },
	{ id: 'roadmap', label: 'What comes next' },
	{ id: 'contact', label: 'Next step' },
]

const pipeline = ['Create', 'Session', 'Gate', 'Pull request', 'Staging', 'Production']

const inherited = [
	{ title: 'Organisations and roles', body: 'Tenancy enforced in Postgres row-level security, not in each query.', href: '/concepts/tenancy/' },
	{ title: 'Sign-in', body: 'Magic links, Google, Microsoft and OIDC, with the company login on top.', href: '/concepts/auth/' },
	{ title: 'A real database', body: 'Postgres with migrations, its own per environment.', href: '/concepts/database/' },
	{ title: 'Background work', body: 'Queues, workflows, cron and realtime from day one.', href: '/concepts/background-work/' },
	{ title: 'AI that is measured', body: 'Chat, agents, retrieval over documents, evals and tracing.', href: '/concepts/ai/' },
	{ title: 'Analytics', body: 'Dashboards over the app’s own data, readable by agents too.', href: '/concepts/analytics/' },
	{ title: 'A command line', body: 'Every feature scriptable, for people and for agents.', href: '/concepts/cli/' },
	{ title: 'Plugins', body: 'Extra capability copied in as code, never a runtime dependency.', href: '/concepts/plugins/' },
]

type Mark = 'y' | 'p' | 'n'
const criteria = ['Anyone can build', 'Real code in your GitHub', 'Runs in your own cloud', 'Company sign-in on every app', 'Approvals and audit', 'Production stack per app']
const rivals: { name: string; marks: Mark[]; us?: boolean }[] = [
	{ name: 'Hosted AI app builders', marks: ['y', 'p', 'n', 'p', 'n', 'p'] },
	{ name: 'Low-code platforms', marks: ['y', 'n', 'p', 'y', 'y', 'p'] },
	{ name: 'An internal platform team', marks: ['n', 'y', 'y', 'p', 'p', 'p'] },
	{ name: 'Rocketflare Launch', marks: ['y', 'y', 'y', 'y', 'y', 'y'], us: true },
]
const MARK = { y: { glyph: '●', text: 'Yes' }, p: { glyph: '◐', text: 'Partly' }, n: { glyph: '○', text: 'No' } }

const stackReasons = [
	{ title: 'Apart from your core infrastructure', body: 'Apps and agents run in Cloudflare accounts of their own, outside the corporate network. A misbehaving app has nothing of yours to reach.' },
	{ title: 'Nothing reaches in unless it is shared', body: 'Corporate APIs, data and SaaS connections reach an app only as an explicit grant: requested, approved by whoever owns them, pushed by Launch, rotated in one place.' },
	{ title: 'Sandboxed agents, keys kept outside', body: 'Each coding session is its own container with its own copy of the repo. The model key and the GitHub token are added on the way out; the container never holds them.' },
	{ title: 'A throwaway database for every agent', body: 'Neon branches are near-instant copies, so every session and every gate run gets a real Postgres of its own, deleted afterwards. No agent touches staging or production data.' },
	{ title: 'A small blast radius per app', body: 'Its own Worker per environment, its own database and role, its own origin. One app cannot read another’s data or cookies, and CI never holds a deploy credential.' },
	{ title: 'Serverless, so idle costs nothing', body: 'No servers, clusters or patching for IT; a new host is live in about 100 ms. Workers bill per request and Neon scales to zero, so fifty quiet apps cost close to nothing. <a href="/costs/">What it costs</a>.' },
]

const roadmap = [
	{ title: 'Upgrade every app at once', body: 'One kit release rolled across the fleet, each app through its own gate and PR. One app at a time is built.', lead: true },
	{ title: 'Grants proven on live Workers', body: 'Shared credentials pushed, rotated and revoked on real apps. Built and tested against fakes today.' },
	{ title: 'Session policy', body: 'How many sessions an app may run at once, and who pays for them, set by policy rather than by hand.' },
	{ title: 'Teardown at scale', body: 'Archiving and removing apps, with their databases and hosts, as routine rather than a careful afternoon.' },
	{ title: 'A Kubernetes edition', body: 'The same Launch and the same apps in a cluster you run, for companies whose policy keeps everything inside their own estate.' },
	{ title: 'A pilot company', body: 'Launch deployed in a company’s own accounts, with its own builders, beyond the people who wrote it.' },
]
---
<BaseLayout
	title="Rocketflare Launch — unlock your builders, safely"
	description="Anyone in the company goes from an idea to a secure, production app in the browser, while IT keeps control of credentials, sign-in, approvals and audit. Self-hosted on your own Cloudflare."
	noindex
>
	<div class="deck">
		<a class="home" href="/" aria-label="Rocketflare home"><LogoMark size={40} /></a>

		<nav class="deck-dots" aria-label="Slides">
			<ol>
				{slides.map((s) => (
					<li><a href={`#${s.id}`} data-slide={s.id} aria-label={s.label} title={s.label}></a></li>
				))}
			</ol>
		</nav>

		<!-- 1 · Cover -->
		<section class="slide slide-cover bg-sky" id="cover">
			<div class="wrap">
				<span class="eyebrow">Rocketflare Launch</span>
				<h1>Unlock your builders, <span class="flare">safely.</span></h1>
				<p class="lede">
					Anyone can go from an idea to a secure, production app in the browser, while IT keeps
					control of credentials, sign-in, approvals and audit.
				</p>
				<ul class="pills" aria-label="In short">
					<li>Self-hosted on your Cloudflare</li>
					<li>Every app a real repo</li>
					<li>Claude Code or Codex</li>
				</ul>
				<p class="hint">Scroll, or use the arrow keys</p>
			</div>
			<a class="next" href="#problem">Next: The problem <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 2 · The problem -->
		<section class="slide" id="problem">
			<div class="wrap">
				<SectionHead eyebrow="The problem" title="Every company has more app ideas than engineers." align="left" />
				<div class="cards three">
					<article class="card">
						<span class="tag">The queue</span>
						<h3>Builders wait</h3>
						<p>The person who knows the process best files a ticket and waits a quarter for a tool that should take a week.</p>
					</article>
					<article class="card">
						<span class="tag">The workaround</span>
						<h3>Shadow apps</h3>
						<p>So they use a hosted AI builder. The app works, but it lives outside company sign-in, holds pasted keys, and nobody in IT knows it exists.</p>
					</article>
					<article class="card">
						<span class="tag">The tax</span>
						<h3>Everything around the app</h3>
						<p>The apps that do get built properly each redo accounts, databases, DNS, secrets, sign-in, deploys, approvals and upgrades.</p>
					</article>
				</div>
				<p class="kicker measure">Agents can now write production code. What is scarce is the safe path from a good idea to a governed, running app.</p>
			</div>
			<a class="next" href="#idea">Next: The idea <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 3 · The idea -->
		<section class="slide" id="idea">
			<div class="wrap">
				<SectionHead eyebrow="The idea" title="The Lovable loop, on your own repo, CI and approvals." align="left" lede="Describe what you want, watch it appear in a live preview, ship it. The loop people already love, with every part of it landing somewhere the company owns." />
				<div class="loop">
					<div class="loop-row loop-head" aria-hidden="true">
						<span></span><span>A hosted AI builder</span><span class="us">Launch</span>
					</div>
					<dl>
						<div class="loop-row"><dt>Where it runs</dt><dd>The vendor’s cloud</dd><dd class="us">Your Cloudflare account</dd></div>
						<div class="loop-row"><dt>Where the code lives</dt><dd>The vendor’s project, optionally synced out</dd><dd class="us">A normal repo in your GitHub</dd></div>
						<div class="loop-row"><dt>Who can sign in</dt><dd>Whoever the builder set up</dd><dd class="us">Your company login, per app</dd></div>
						<div class="loop-row"><dt>How it reaches production</dt><dd>A publish button</dd><dd class="us">Gate, pull request, approval</dd></div>
						<div class="loop-row"><dt>What it is built on</dt><dd>A fresh prototype each time</dd><dd class="us">A production kit, the same for every app</dd></div>
					</dl>
				</div>
			</div>
			<a class="next" href="#how">Next: How it works <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 4 · How it works -->
		<section class="slide" id="how">
			<div class="wrap">
				<SectionHead eyebrow="How it works" title="From a form to production, without a terminal." align="left" />
				<div class="diagram-wrap">
					<DiagramSteps
						steps={pipeline}
						retryFrom={2}
						retryTo={1}
						retryLabel="fix turn"
						note="Staging is automatic; production waits for a person."
						describedBy="how-steps"
						title="An app's path through Launch, from creation to production"
					/>
				</div>
				<ol class="steps-list" id="how-steps">
					<li><strong>Create.</strong> A name and a team. Launch makes the repo, database, Workers, email identity and hosts.</li>
					<li><strong>Session.</strong> Chat with a coding agent in a sandbox, against the app’s real code, with a live preview.</li>
					<li><strong>Gate.</strong> Launch runs the app’s own checks on a throwaway database; a red check gets one focused fix turn.</li>
					<li><strong>Pull request.</strong> Launch opens it, waits for CI and an optional review, then merges.</li>
					<li><strong>Staging.</strong> A release is cut and followed until it is live.</li>
					<li><strong>Production.</strong> Waits for an approval in Launch, then Launch deploys it.</li>
				</ol>
			</div>
			<a class="next" href="#create">Next: Create an app <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 5 · Create -->
		<section class="slide" id="create">
			<div class="wrap split">
				<div class="copy">
					<SectionHead eyebrow="Create an app" title="Minutes from a form to a staging URL." align="left" />
					<p>Nobody opened a terminal. One durable workflow sets up everything an app needs, and you can follow each step on the app’s page.</p>
					<ul class="points">
						<li>A private GitHub repository from a pinned kit release</li>
						<li>A Neon Postgres database, staging and production</li>
						<li>Cloudflare Workers, storage, queues and secrets</li>
						<li><code>expense-approvals.your-apps.com</code>, with a certificate</li>
						<li>Company sign-in configured from the first deploy</li>
					</ul>
				</div>
				<Screenshot light={createLight} dark={createDark} alt="Launch's Create an app dialog: name Expense approvals, the slug expense-approvals with its staging and production hosts, owner team Finance, a description, and Deploy staging now switched on" url="launch.your-company.com/apps" priority />
			</div>
			<a class="next" href="#build">Next: Build by chatting <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 6 · Build -->
		<section class="slide" id="build">
			<div class="wrap split reverse">
				<div class="copy">
					<SectionHead eyebrow="Build by chatting" title="A coding agent, the app’s real code, a live preview." align="left" />
					<p>Each session is a sandbox with its own copy of the repo and its own database branch. The agent reads the kit’s rules and skills, so it builds the way the codebase expects.</p>
					<ul class="points">
						<li>24 seconds from nothing to a live preview, measured on Cloudflare</li>
						<li>Claude Code or Codex, model chosen per message</li>
						<li>Billed to the company key, or to the builder’s own subscription</li>
						<li>Screenshot the preview into the chat; queue or interrupt a turn</li>
						<li>A budget per session, metered outside the sandbox</li>
					</ul>
				</div>
				<Screenshot light={sessionLight} dark={sessionDark} alt="A Launch coding session: the conversation with Claude Code on the left, the Ship panel with lint, typecheck and tests passed on a Neon gate branch at top right, and the app's live preview below it" url="launch.your-company.com/apps/hola-world/sessions" />
			</div>
			<a class="next" href="#ship">Next: Ship through the gate <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 7 · Ship -->
		<section class="slide" id="ship">
			<div class="wrap split">
				<div class="copy">
					<SectionHead eyebrow="Ship through the gate" title="Shipping is a button. Production is a decision." align="left" />
					<p>Launch runs the gate itself, opens the pull request, waits for CI and follows the release to staging. Production waits for someone allowed to say yes.</p>
					<ul class="points">
						<li>No model call decides whether a check passed</li>
						<li>Approvers, how many, and whether you may approve your own work, set by policy</li>
						<li>Production can ship the exact build staging ran, not a rebuild</li>
						<li>Works on any GitHub plan; no Enterprise needed</li>
					</ul>
				</div>
				<Screenshot light={approvalLight} dark={approvalDark} alt="A production deploy approval in Launch: why it was asked, what would go to production, who decides (the app's owners or the organisation's admins, 1 of 1, self-approval not allowed) and the decision" url="launch.your-company.com/approvals" />
			</div>
			<a class="next" href="#production">Next: Production-grade <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 8 · Production-grade -->
		<section class="slide" id="production">
			<div class="wrap">
				<SectionHead eyebrow="Production-grade from day one" title="Every app starts where most apps hope to end up." align="left" lede="Launch only makes Rocketflare apps, and Rocketflare is an open-source kit with the hard parts already written. So the app a builder starts on Monday has what a platform team would ask for." />
				<ul class="cards four">
					{inherited.map((f) => (
						<li class="card">
							<h3><a href={f.href}>{f.title}</a></h3>
							<p>{f.body}</p>
						</li>
					))}
				</ul>
			</div>
			<a class="next" href="#control">Next: IT stays in control <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 9 · Control -->
		<section class="slide bg-band" id="control">
			<div class="wrap split">
				<div class="copy">
					<SectionHead eyebrow="IT stays in control" title="One place to say who, what and whether." align="left" />
					<ul class="points">
						<li><strong>One sign-in.</strong> Launch is the identity provider for every app, with access per app and a request-access flow when someone is turned away.</li>
						<li><strong>One approvals engine.</strong> Eight kinds of request, from creating an app to merging a session to promoting to production.</li>
						<li><strong>One audit log.</strong> Append-only in the database, sealed into a hash chain, verifiable and exportable.</li>
						<li><strong>One place for credentials.</strong> The account tokens stay in Launch. Apps get only their runtime secrets.</li>
					</ul>
				</div>
				<Screenshot light={auditLight} dark={auditDark} alt="Launch's audit log: an integrity panel with Verify, CSV and JSON Lines, above a table of events such as session.created, app.upgrade.started and setting.changed with actor, target and summary" url="launch.your-company.com/audit" />
			</div>
			<a class="next" href="#yours">Next: Yours, not ours <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 10 · Yours -->
		<section class="slide" id="yours">
			<div class="wrap">
				<SectionHead eyebrow="Yours, not ours" title="If Launch disappeared, every app would keep running." align="left" lede="Launch runs in the company’s own Cloudflare account, one copy per company. The apps are normal repos and Workers that can still be deployed by hand." />
				<div class="two">
					<ul class="estate" aria-label="Where everything lives">
						<li class="tone-orange"><span class="owner">Your Cloudflare · Launch account</span><strong>Launch</strong><span>Console, sign-in, approvals, audit, coding sessions</span></li>
						<li class="tone-blue"><span class="owner">Your Cloudflare · apps account</span><strong>Every app</strong><span>A Worker per environment, its storage, queues and hosts</span></li>
						<li class="tone-purple"><span class="owner">Your GitHub organisation</span><strong>Every repo</strong><span>The code, its CI and its releases, under any licence you choose</span></li>
						<li class="tone-green"><span class="owner">Your Neon organisation</span><strong>Every database</strong><span>A project per app; a branch per session and per gate run</span></li>
					</ul>
					<div class="seq">
						<DiagramSequence
							actors={['Agent sandbox', 'Launch', 'Model provider']}
							messages={[
								{ from: 0, to: 1, label: 'placeholder key' },
								{ from: 1, to: 1, label: 'allow-list, meter' },
								{ from: 1, to: 2, label: 'real key added' },
								{ from: 2, to: 1, label: 'response' },
								{ from: 1, to: 0, label: 'response' },
							]}
							describedBy="key-steps"
							title="How a coding agent reaches the model without ever holding the key"
						/>
						<ol class="steps-list small" id="key-steps">
							<li>The agent calls the model with a placeholder; the sandbox holds no real credential.</li>
							<li>Launch checks the host against the session’s allow-list and meters the call.</li>
							<li>Launch swaps the real key or subscription token in on the way out.</li>
							<li>The response comes back the same way. CI, likewise, holds no Cloudflare token.</li>
						</ol>
					</div>
				</div>
			</div>
			<a class="next" href="#stack">Next: Why Cloudflare and Neon <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 10b · Why the stack -->
		<section class="slide" id="stack">
			<div class="wrap">
				<SectionHead eyebrow="So why Cloudflare and Neon?" title="A stack chosen so letting everyone build is safe." align="left" />
				<ul class="cards three">
					{stackReasons.map((r) => (
						<li class="card">
							<h3>{r.title}</h3>
							<p set:html={r.body} />
						</li>
					))}
				</ul>
				<p class="kicker tight measure">Plain Postgres and ordinary code in your repo, so none of it is a lock-in. A Kubernetes edition is on the roadmap.</p>
			</div>
			<a class="next" href="#fleet">Next: The fleet <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 11 · Fleet -->
		<section class="slide" id="fleet">
			<div class="wrap split reverse">
				<div class="copy">
					<SectionHead eyebrow="The fleet stays current" title="Fifty apps, not fifty snowflakes." align="left" />
					<p>Apps made by hand drift years behind their template. Launch knows which kit release every app is on, and an upgrade is a session like any other: an agent applies the porting notes, Launch gates it and opens the pull request.</p>
					<ul class="points">
						<li>Kit releases flagged per app, with the release notes a click away</li>
						<li>Shared credentials, such as a Microsoft 365 connection, granted by their owner and pushed to the apps that hold them</li>
						<li>One rotation updates every app with that grant</li>
					</ul>
				</div>
				<Screenshot light={appLight} dark={appDark} alt="An app's page in Launch: staging on v0.15.8 and live on v0.15.7, both up, a Ship v0.15.8 live button, and a Kit section saying it requires an upgrade to 0.17.0 with a link to the upgrade session" url="launch.your-company.com/apps/hola-world" crop="top" />
			</div>
			<a class="next" href="#contrast">Next: Versus the alternatives <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 12 · Contrast -->
		<section class="slide" id="contrast">
			<div class="wrap">
				<SectionHead eyebrow="Versus the alternatives" title="The only one that does all of it." align="left" />
				<div class="table-wrap" tabindex="0" role="region" aria-labelledby="contrast-caption">
					<table>
						<caption id="contrast-caption">How each approach to internal apps compares</caption>
						<thead>
							<tr><th scope="col"><span class="sr-only">Approach</span></th>{criteria.map((c) => <th scope="col">{c}</th>)}</tr>
						</thead>
						<tbody>
							{rivals.map((r) => (
								<tr class:list={[r.us && 'us']}>
									<th scope="row">{r.name}</th>
									{r.marks.map((m) => <td class={m}><span aria-hidden="true">{MARK[m].glyph}</span> {MARK[m].text}</td>)}
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="fine">Our read of each category, not a scorecard of any one vendor.</p>
			</div>
			<a class="next" href="#proof">Next: Where it stands <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 13 · Proof -->
		<section class="slide" id="proof">
			<div class="wrap">
				<SectionHead eyebrow="Where it stands" title="Built, and running real apps." align="left" lede="Creating apps, coding sessions, the gate, approvals and grants are built, and the people building Launch use it every day. Apps it created are live on staging and production, promoted through its own approval gate." />
				<dl class="stats">
					<div><dt>to a live preview</dt><dd>24 s</dd></div>
					<div><dt>kinds of approval, one engine</dt><dd>8</dd></div>
					<div><dt>automated tests in Launch</dt><dd>~3,100</dd></div>
					<div><dt>apps live through the gate</dt><dd>2</dd></div>
				</dl>
				<Callout tone="yellow" title="What we don’t claim yet">
					<p>Launch has run only in its builders’ own accounts; there is no customer yet. Shared-credential grants are tested against fakes, not live Workers. The sandbox’s network allow-list is built but switched off while a Cloudflare bug is fixed, so a session can reach the internet today, though never with a key. Upgrading the whole fleet at once is designed, not built. Pricing is not set.</p>
				</Callout>
			</div>
			<a class="next" href="#model">Next: How it makes money <span aria-hidden="true">↓</span></a>
		</section>

		<!-- 14 · Model -->
		<section class="slide" id="model">
			<div class="wrap">
				<SectionHead eyebrow="How it makes money" title="Open kit, licensed console." align="left" />
				<div class="cards three">
					<article class="card tone-green">
						<span class="tag">Adoption</span>
						<h3>The kit is MIT</h3>
						<p>Free, open source and useful on its own. It is how engineers find Rocketflare, and every app Launch makes is a kit app, so the kit’s quality is Launch’s quality.</p>
					</article>
					<article class="card tone-orange">
						<span class="tag">Revenue</span>
						<h3>Launch is source-available</h3>
						<p>Elastic License 2.0: a company may run it, read it and change it for itself, but not resell it as a service or get around its licence key. The licence key is the commercial line.</p>
					</article>
					<article class="card tone-blue">
						<span class="tag">Open question</span>
