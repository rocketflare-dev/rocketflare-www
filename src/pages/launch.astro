<script>
	// Arrow keys, PageUp/PageDown, j/k, Home/End step between slides; the dots
	// follow the slide under the middle of the screen. Keys inside a form field,
	// a tab strip or the comparison table's scroller are left alone.
	const slides = [...document.querySelectorAll<HTMLElement>('.slide')]
	const dots = [...document.querySelectorAll<HTMLAnchorElement>('.deck-dots a')]
	const NEXT = ['ArrowDown', 'ArrowRight', 'PageDown', 'j']
	const PREV = ['ArrowUp', 'ArrowLeft', 'PageUp', 'k']

	const current = () => {
		const mid = window.innerHeight / 2
		const i = slides.findIndex((s) => {
			const r = s.getBoundingClientRect()
			return r.top <= mid && r.bottom > mid
		})
		return Math.max(0, i)
	}
	const go = (i: number) => slides[Math.max(0, Math.min(slides.length - 1, i))]?.scrollIntoView({ block: 'start' })

	document.addEventListener('keydown', (e) => {
		if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return
		if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable], [role="tablist"], .table-wrap')) return
		const step = NEXT.includes(e.key) ? 1 : PREV.includes(e.key) ? -1 : 0
		if (step) go(current() + step)
		else if (e.key === 'Home') go(0)
		else if (e.key === 'End') go(slides.length - 1)
		else return
		e.preventDefault()
	})

	const io = new IntersectionObserver((entries) => {
		for (const en of entries) {
			if (en.isIntersecting) dots.forEach((d) => d.setAttribute('aria-current', String(d.dataset.slide === en.target.id)))
		}
	}, { rootMargin: '-50% 0px -50% 0px' })
	slides.forEach((s) => io.observe(s))
</script>
