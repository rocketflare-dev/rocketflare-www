---
/**
 * The block that opens a section: an optional eyebrow, the heading, an
 * optional lede — the shape every section on the site already uses, in one
 * place.
 *
 * Props
 * - `title`     the h2
 * - `eyebrow?`  small uppercase line above it
 * - `lede?`     one paragraph under it (plain text; use the default slot for markup)
 * - `audience?` renders a tag: 'builder' → "For builders" (orange),
 *               'engineer' → "Under the hood" (blue) — via the .tone-* tokens
 * - `align?`    'center' (default) or 'left'
 */
interface Props {
	eyebrow?: string
	title: string
	lede?: string
	audience?: 'builder' | 'engineer'
	align?: 'center' | 'left'
}
const { eyebrow, title, lede, audience, align = 'center' } = Astro.props

const AUDIENCE = {
	builder: { label: 'For builders', tone: 'orange' },
	engineer: { label: 'Under the hood', tone: 'blue' },
} as const
const tag = audience ? AUDIENCE[audience] : undefined
---
<div class:list={['section-head', `align-${align}`]}>
	{(tag || eyebrow) && (
		<div class="meta">
			{tag && <span class={`audience tone-${tag.tone}`}>{tag.label}</span>}
			{eyebrow && <span class="eyebrow">{eyebrow}</span>}
		</div>
	)}
	<h2>{title}</h2>
	{lede && <p class="lede">{lede}</p>}
	<slot />
</div>

<style>
	/* .section-head itself (centred, 720px, bottom margin) is global in BaseLayout. */
	.align-left { text-align: left; margin-left: 0; }
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.6rem 0.9rem;
		margin-bottom: 0.9rem;
	}
	.align-left .meta { justify-content: flex-start; }
	.meta .eyebrow { margin-bottom: 0; }
	.audience {
		display: inline-flex;
		align-items: center;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-ink);
		background: var(--tint);
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		border-radius: 999px;
		padding: 0.28rem 0.75rem;
	}
	.lede { font-size: 1.08rem; color: var(--text-muted); }
	.align-left .lede { max-width: 62ch; }
</style>
