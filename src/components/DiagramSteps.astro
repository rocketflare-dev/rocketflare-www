---
/**
 * A left-to-right pipeline of steps, optionally with a retry loop drawn back
 * from one step to an earlier one, and a note beneath.
 *
 * Props
 * - `steps`        short labels, in order (three words or fewer each)
 * - `retryFrom?`   index of the step a retry starts from
 * - `retryTo?`     index it loops back to (default: the same step — "re-claims")
 * - `retryLabel?`  default "retry"
 * - `note?`        one line under the pipeline
 * - `describedBy`  id of the ordered list beneath (aria-describedby)
 * - `title?`       the SVG <title>
 */
interface Props {
	steps: string[]
	retryFrom?: number
	retryTo?: number
	retryLabel?: string
	note?: string
	describedBy: string
	title?: string
}
const { steps, retryFrom, retryTo = retryFrom, retryLabel = 'retry', note, describedBy, title = 'A sequence of steps' } = Astro.props
const id = `${describedBy}-svg`

const PAD = 16
const BOX = 150
const BOXH = 50
const GAPX = 40
const LOOP = retryFrom !== undefined ? 60 : 0
const n = steps.length
const W = PAD * 2 + n * BOX + (n - 1) * GAPX
const top = PAD + LOOP
const H = top + BOXH + (note ? 36 : 0) + PAD
const x = (i: number) => PAD + i * (BOX + GAPX)
const hasLoop = retryFrom !== undefined && retryTo !== undefined
const loopFrom = hasLoop ? x(retryFrom!) + BOX / 2 : 0
const loopTo = hasLoop ? x(retryTo!) + BOX / 2 + (retryFrom === retryTo ? 40 : 0) : 0
const loopStart = retryFrom === retryTo ? loopFrom - 40 : loopFrom
---
<svg class="diagram" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-title`} aria-describedby={describedBy}>
	<title id={`${id}-title`}>{title}</title>
	<defs>
		<marker id={`${id}-m`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0L10 5 0 10z" fill="var(--blue-bright)" /></marker>
		<marker id={`${id}-r`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0L10 5 0 10z" fill="var(--orange)" /></marker>
	</defs>

	{steps.map((s, i) => (
		<g>
			<rect x={x(i)} y={top} width={BOX} height={BOXH} rx="25" fill="var(--card)" stroke="var(--border-bright)" stroke-width="1.5" />
			<circle cx={x(i) + 24} cy={top + BOXH / 2} r="10" fill="var(--blue-bright)" />
			<text class="num" x={x(i) + 24} y={top + BOXH / 2 + 4} text-anchor="middle">{i + 1}</text>
			<text class="label" x={x(i) + 42} y={top + BOXH / 2 + 5}>{s}</text>
			{i < n - 1 && <line x1={x(i) + BOX + 4} y1={top + BOXH / 2} x2={x(i + 1) - 10} y2={top + BOXH / 2} stroke="var(--blue-bright)" stroke-width="2.5" marker-end={`url(#${id}-m)`} />}
		</g>
	))}

	{hasLoop && (
		<g>
			<path d={`M${loopStart} ${top} C${loopStart} ${top - LOOP + 30} ${loopTo} ${top - LOOP + 30} ${loopTo} ${top - 6}`} fill="none" stroke="var(--orange)" stroke-width="2.5" stroke-dasharray="6 5" marker-end={`url(#${id}-r)`} />
			<text class="loop" fill="var(--orange)" x={(loopStart + loopTo) / 2} y={top - LOOP + 12} text-anchor="middle">{retryLabel}</text>
		</g>
	)}

	{note && <text class="note" x={W / 2} y={top + BOXH + 26} text-anchor="middle">{note}</text>}
</svg>

<style>
	.diagram { display: block; width: 100%; height: auto; font-family: var(--sans); }
	.label { fill: var(--text-bright); font-size: 14.5px; font-weight: 600; }
	.num { fill: var(--on-accent); font-size: 11px; font-weight: 800; }
	.note { fill: var(--text-muted); font-size: 12.5px; }
	.loop { font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
