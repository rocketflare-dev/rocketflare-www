---
import BaseLayout from './BaseLayout.astro'
import ConceptIcon from '../components/ConceptIcon.astro'
import { CONCEPTS, CONCEPT_GROUPS, conceptBySlug, conceptsInGroup } from '../data/concepts'
import { CONCEPTS_URL, GITHUB_URL } from '../data/site'
import { lastmodFor } from '../data/lastmod'

interface Props {
	slug: string
	/** Repo paths the reader should open next. */
	source?: string[]
}
const { slug, source = [] } = Astro.props
const c = conceptBySlug(slug)
if (!c) throw new Error(`Unknown concept slug: ${slug}`)

const i = CONCEPTS.findIndex((x) => x.slug === slug)
const prev = CONCEPTS[i - 1]
const next = CONCEPTS[i + 1]
const reference = c.anchor ? `${CONCEPTS_URL}#${c.anchor}` : `${GITHUB_URL}/blob/main/CLAUDE.md`

/**
 * A concept page is an article about one subsystem, two levels down. Both
 * facts are worth stating: the TechArticle is what an answer engine quotes,
 * and the BreadcrumbList is what puts "Concepts" above it in a result rather
 * than a bare URL. The site-wide graph (BaseLayout) carries the rest.
 */
const site = Astro.site?.toString() ?? 'https://rocketflare.dev/'
const url = new URL(`/concepts/${c.slug}/`, Astro.site).toString()
const modified = lastmodFor(url)

const articleLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'TechArticle',
			'@id': `${url}#article`,
			headline: c.title,
			description: c.blurb,
			url,
			isPartOf: { '@id': `${site}#website` },
			about: { '@id': `${site}#software` },
			publisher: { '@id': `${site}#organization` },
			inLanguage: 'en-GB',
			...(modified ? { dateModified: modified.toISOString() } : {}),
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${url}#breadcrumbs`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: site },
				{ '@type': 'ListItem', position: 2, name: 'Concepts', item: `${site}concepts/` },
				{ '@type': 'ListItem', position: 3, name: c.title, item: url },
			],
		},
	],
}
---
<BaseLayout
	title={`${c.title} — Rocketflare`}
	description={c.blurb}
	ogType="article"
	jsonLd={articleLd}
>
	<div class={`concept tone-${c.tone}`}>
		<header class="concept-hero page-hero">
			<div class="wrap">
				<div class="hero-copy">
					<a class="crumb" href="/concepts/">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
						All concepts
					</a>
					<div class="concept-title">
						<span class="chip"><ConceptIcon name={c.icon} /></span>
						<div>
							<span class="eyebrow">{c.num} — Concept</span>
							<h1>{c.title}</h1>
						</div>
					</div>
					<p class="lede">{c.blurb}</p>
				</div>
			</div>
		</header>

		<div class="wrap concept-body">
			<aside class="side">
				<p class="side-head">Concepts</p>
				<nav aria-label="Concepts">
					{CONCEPT_GROUPS.map((g) => (
						<div class="side-group">
							<span class="side-group-head">{g.title}</span>
							{conceptsInGroup(g.key).map((x) => (
								<a href={`/concepts/${x.slug}/`} class:list={['side-link', x.slug === slug && 'current']}>
									<span class="side-num">{x.num}</span> {x.title}
								</a>
							))}
						</div>
					))}
				</nav>
				<a class="side-ref" href={reference} target="_blank" rel="noopener">
					{c.anchor ? "Full reference on GitHub" : "Read CLAUDE.md on GitHub"}
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
				</a>
			</aside>

			<article class="prose">
				<slot />

				{source.length > 0 && (
					<div class="source-box">
						<h3>Where this lives</h3>
						<ul>
							{source.map((p) => (
								<li><a href={`${GITHUB_URL}/blob/main/${p}`} target="_blank" rel="noopener"><code>{p}</code></a></li>
							))}
						</ul>
					</div>
				)}

				<nav class="pager" aria-label="Previous and next concept">
					{prev ? (
						<a href={`/concepts/${prev.slug}/`} class="pager-link prev">
							<span>Previous</span>
							<strong>{prev.title}</strong>
						</a>
					) : <span />}
					{next && (
						<a href={`/concepts/${next.slug}/`} class="pager-link next">
							<span>Next</span>
							<strong>{next.title}</strong>
						</a>
					)}
				</nav>
			</article>
		</div>
	</div>
</BaseLayout>

<style>
	/* --accent / --tint come from the global .tone-* classes in BaseLayout. */
	.concept-hero {
		position: relative;
		background:
			radial-gradient(1100px 420px at 15% -30%, var(--tint), transparent 70%),
			linear-gradient(180deg, var(--sky-top), var(--bg));
		border-bottom: 1px solid var(--border);
	}
	/* Width, h1 and lede come from the global .page-hero (BaseLayout). */
	.crumb {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--text-muted);
		margin-bottom: 1.4rem;
	}
	.crumb:hover { color: var(--accent); text-decoration: none; }
	.concept-title { display: flex; gap: 1.1rem; align-items: center; }
	/* Beats the global .page-hero h1 margin: the chip row sets the spacing. */
	.concept-hero .concept-title h1 { margin: 0; }
	.chip {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		border-radius: 18px;
		background: var(--card);
		border: 1px solid var(--border);
		color: var(--accent);
		box-shadow: var(--shadow-sm);
	}
	.chip :global(svg) { width: 28px; height: 28px; }
	.eyebrow { color: var(--accent-ink); }
	.concept-hero .lede { margin-top: 1.2rem; }

	.concept-body {
		display: grid;
		grid-template-columns: 250px minmax(0, 1fr);
		gap: 3rem;
		padding-top: 3rem;
		padding-bottom: 5rem;
		align-items: start;
	}
	.side { position: sticky; top: 5.5rem; }
	.side-head {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.7rem;
	}
	.side nav { display: flex; flex-direction: column; gap: 0.9rem; border-left: 2px solid var(--border); }
	.side-group { display: flex; flex-direction: column; }
	.side-group-head {
		padding: 0 0.9rem 0.25rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.side-link {
		display: flex;
		gap: 0.5rem;
		padding: 0.4rem 0.9rem;
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--text-muted);
		border-left: 2px solid transparent;
		margin-left: -2px;
	}
	.side-link:hover { color: var(--text-bright); text-decoration: none; }
	.side-num { flex: none; font-family: var(--mono); font-size: 0.76rem; padding-top: 0.15em; }
	.side-link.current { color: var(--accent-ink); font-weight: 600; border-left-color: var(--accent); }
	.side-ref {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.4rem;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--accent-ink);
	}

	/* ------------------------------------------------------------ prose -- */
	.prose { max-width: 74ch; }
	.prose :global(h2) {
		font-size: 1.6rem;
		margin-top: 2.8rem;
		margin-bottom: 0.7rem;
		padding-top: 0.2rem;
	}
	.prose :global(h2:first-child) { margin-top: 0; }
	.prose :global(h3) { margin-top: 2rem; font-size: 1.1rem; }
	.prose :global(p) { color: var(--text); }
	.prose :global(ul), .prose :global(ol) { padding-left: 0; margin: 0 0 1.2rem; }
	.prose :global(ul) { list-style: none; }
	.prose :global(ul > li) {
		position: relative;
		padding-left: 1.4rem;
		margin-bottom: 0.5rem;
	}
	.prose :global(ul > li)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: var(--accent);
		transform: rotate(45deg);
	}
	.prose :global(ol) { padding-left: 1.3rem; }
	.prose :global(ol > li) { margin-bottom: 0.5rem; }
	.prose :global(pre) { margin: 1.2rem 0; }
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.4rem 0;
		font-size: 0.92rem;
	}
	.prose :global(th) {
		text-align: left;
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		border-bottom: 2px solid var(--border);
		padding: 0.5rem 0.7rem;
	}
	.prose :global(td) {
		border-bottom: 1px solid var(--border);
		padding: 0.6rem 0.7rem;
		vertical-align: top;
	}
	.prose :global(tr:hover td) { background: var(--card-alt); }

	/* A diagram (one of the Diagram* components) with its caption: full prose width. */
	.prose :global(.figure) { margin: 1.5rem 0; }
	.prose :global(.figure figcaption) {
		margin-top: 0.7rem;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--text-muted);
	}
	.prose :global(.figure + table) { margin-top: 0.6rem; }

	/* A "why" callout: the decision behind the thing just described. */
	.prose :global(.why) {
		border-left: 4px solid var(--accent);
		background: var(--tint);
		border-radius: 0 14px 14px 0;
		padding: 1.1rem 1.3rem;
		margin: 1.6rem 0;
	}
	.prose :global(.why p:last-child) { margin-bottom: 0; }
	.prose :global(.why strong:first-child) { color: var(--accent-ink); }

	.prose :global(.note) {
		border: 1px dashed var(--border-bright);
		border-radius: 14px;
		padding: 1rem 1.2rem;
		margin: 1.6rem 0;
		font-size: 0.94rem;
		color: var(--text-muted);
	}
	.prose :global(.note p:last-child) { margin-bottom: 0; }

	.source-box {
		margin-top: 3rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 1.3rem 1.5rem;
	}
	.source-box h3 { margin-top: 0; font-size: 0.95rem; }
	.source-box ul { margin: 0; }
	.source-box :global(code) { background: none; padding: 0; font-size: 0.86rem; }

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.pager-link {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.9rem 1.2rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--card);
		max-width: 48%;
	}
	.pager-link:hover { text-decoration: none; border-color: var(--accent); }
	.pager-link span { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }
	.pager-link strong { color: var(--text-bright); font-size: 0.98rem; }
	.pager-link.next { text-align: right; margin-left: auto; }

	@media (max-width: 900px) {
		.concept-body { grid-template-columns: 1fr; gap: 2rem; }
		.side { position: static; }
		.side nav { display: none; }
	}
</style>
