---
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { GITHUB_URL } from '../data/site'

interface Props {
	title: string
	description: string
	ogImage?: string
	ogType?: 'website' | 'article'
	/** Extra JSON-LD to emit alongside the site-wide graph. */
	jsonLd?: Record<string, unknown>
}

const {
	title,
	description,
	ogImage = '/og-image.png',
	ogType = 'website',
	jsonLd,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(ogImage, Astro.site)
const siteURL = Astro.site?.toString() ?? 'https://rocketflare.dev/'

// One software-application entity for the whole site: this is what a search
// engine (and an AI answer engine) reads to know what Rocketflare actually is.
const softwareLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Rocketflare',
	alternateName: 'Rocketflare SaaS starter kit',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Cloudflare Workers, Node.js 24',
	url: siteURL,
	codeRepository: GITHUB_URL,
	license: 'https://opensource.org/licenses/MIT',
	description:
		'An open-source multi-tenant B2B SaaS starter kit for Cloudflare Workers: tenancy, authentication, roles and permissions, background jobs, realtime, file storage, analytics dashboards, an AI agent layer and a CLI, running as one Worker over Postgres.',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	keywords:
		'B2B SaaS Cloudflare, SaaS app Cloudflare Workers, agentic SaaS, multi-tenant SaaS starter kit, Cloudflare Workers boilerplate, Hono, Drizzle, Postgres, AI agents',
}
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="canonical" href={canonicalURL} />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="llms-txt" href="/llms.txt" />
	<meta name="theme-color" content="#3B82C4" />
	<title>{title}</title>
	<meta name="description" content={description} />

	<meta property="og:type" content={ogType} />
	<meta property="og:site_name" content="Rocketflare" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:image" content={ogImageURL} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Rocketflare — a multi-tenant SaaS starter kit for Cloudflare Workers" />
	<meta property="og:locale" content="en_GB" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageURL} />

	<meta name="author" content="Rocketflare" />
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />
	{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

	<!-- Theme boot before first paint, so there is no flash. Day is the default;
	     only an explicit saved choice or an OS dark preference switches it. -->
	<script is:inline>
		(function () {
			try {
				var saved = localStorage.getItem('theme')
				var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day')
				document.documentElement.setAttribute('data-theme', theme)
			} catch (e) {
				document.documentElement.setAttribute('data-theme', 'day')
			}
		})()
	</script>
</head>
<body>
	<Nav />
	<slot />
	<Footer />
</body>
</html>

<style is:global>
	/* ==================================================================== *
	 * Rocketflare — token-first design system.
	 *
	 * EVERY colour on this site is a token below and is referenced with
	 * var(), including inside the inline SVG illustrations (an SVG
	 * presentation attribute resolves custom properties, so the clouds and
	 * the sky re-theme themselves). Never write a raw hex in a page; add a
	 * token here instead. The one deliberate exception is the logo mark
	 * itself (components/LogoMark.astro), whose brand fills are fixed.
	 *
	 * The palette IS the logo: sky blue, cloud cyan, sun yellow, flare
	 * orange, rocket red, cream. Day is the default; Night is the same
	 * illustration after dark.
	 * ==================================================================== */
	:root,
	html[data-theme='day'] {
		/* Brand */
		--blue: #2E6FB0;
		--blue-bright: #3B82C4;
		--cyan: #4FB3D4;
		--cyan-soft: #91D4E8;
		--yellow: #E0A81C;
		--yellow-bright: #F2C94C;
		--orange: #E8872F;
		--red: #E65A3A;
		--purple: #7C5CD6;
		--green: #2E9E6B;

		/* Sky — the page background gradient */
		--sky-top: #CFEAF7;
		--sky-mid: #E6F4FB;
		--sky-bottom: #FFF8EC;
		--cloud: #FFFFFF;
		--cloud-soft: #EAF5FC;
		--cloud-shade: #D6EAF6;

		/* Surfaces + text */
		--bg: #F2FAFE;
		--card: #FFFFFF;
		--card-alt: #F6FBFE;
		--code-bg: #10243A;
		--code-text: #D7E6F5;
		--border: #D3E6F2;
		--border-bright: #B4D6E9;
		--text: #24425C;
		--text-muted: #5A778E;
		--text-bright: #10243A;
		--shadow: 24px 30px -18px rgba(16, 36, 58, 0.22);
		--shadow-sm: 0 4px 14px -6px rgba(16, 36, 58, 0.2);

		/* Tints — a wash of an accent behind an icon chip */
		--tint-blue: #E3F0FB;
		--tint-cyan: #DEF3FA;
		--tint-yellow: #FCF1D4;
		--tint-orange: #FCEBDA;
		--tint-red: #FBE3DD;
		--tint-purple: #ECE6FB;
		--tint-green: #DDF2E8;

		--sun: #F7D257;
		--star: transparent;

		--mono: 'JetBrains Mono', ui-monospace, monospace;
		--sans: 'Outfit', ui-sans-serif, system-ui, -apple-system, sans-serif;

		color-scheme: light;
	}

	html[data-theme='night'] {
		--blue: #6FB2E8;
		--blue-bright: #8CC6F2;
		--cyan: #7FD6EE;
		--cyan-soft: #A9E4F5;
		--yellow: #F5D371;
		--yellow-bright: #FCE39A;
		--orange: #F5A45C;
		--red: #F58367;
		--purple: #B39BF5;
		--green: #6FD6A5;

		--sky-top: #0A1526;
		--sky-mid: #12233C;
		--sky-bottom: #1D2E45;
		--cloud: #26405E;
		--cloud-soft: #1B3049;
		--cloud-shade: #16283E;

		--bg: #0C182A;
		--card: #16273D;
		--card-alt: #1B2E48;
		--code-bg: #0A1524;
		--code-text: #C7DCF0;
		--border: #24405F;
		--border-bright: #35597F;
		--text: #C4D8EC;
		--text-muted: #8AA5C0;
		--text-bright: #EFF6FD;
		--shadow: 24px 30px -18px rgba(0, 0, 0, 0.55);
		--shadow-sm: 0 4px 14px -6px rgba(0, 0, 0, 0.5);

		--tint-blue: #1B3454;
		--tint-cyan: #17354A;
		--tint-yellow: #3A3016;
		--tint-orange: #3B2A16;
		--tint-red: #3B211A;
		--tint-purple: #2A2350;
		--tint-green: #143528;

		--sun: #F5D371;
		--star: #DCEBFA;

		color-scheme: dark;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html { scroll-behavior: smooth; scroll-padding-top: 5rem; }

	body {
		margin: 0;
		font-family: var(--sans);
		color: var(--text);
		background: var(--bg);
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	h1, h2, h3, h4 {
		color: var(--text-bright);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 0.6em;
	}
	h1 { font-size: clamp(2.4rem, 6.5vw, 4.4rem); font-weight: 800; }
	h2 { font-size: clamp(1.8rem, 4vw, 2.75rem); font-weight: 700; }
	h3 { font-size: 1.2rem; font-weight: 600; }
	p { margin: 0 0 1rem; }

	a { color: var(--blue); text-decoration: none; }
	a:hover { text-decoration: underline; }

	code {
		font-family: var(--mono);
		font-variant-ligatures: none;
		font-size: 0.875em;
		background: var(--tint-blue);
		color: var(--text-bright);
		padding: 0.12em 0.4em;
		border-radius: 5px;
	}
	pre {
		font-family: var(--mono);
		font-variant-ligatures: none;
		background: var(--code-bg);
		color: var(--code-text);
		padding: 1.25rem 1.4rem;
		border-radius: 14px;
		overflow-x: auto;
		font-size: 0.85rem;
		line-height: 1.75;
		margin: 0;
	}
	pre code { background: none; color: inherit; padding: 0; font-size: inherit; }

	:focus-visible {
		outline: 3px solid var(--orange);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* ---------------------------------------------------------- layout -- */
	.wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
	.wrap-narrow { max-width: 860px; margin: 0 auto; padding: 0 1.5rem; }

	section { position: relative; }

	.eyebrow {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--orange);
		margin-bottom: 0.9rem;
	}
	.section-head { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
	.section-head p { color: var(--text-muted); font-size: 1.08rem; }

	/* ---------------------------------------------------------- buttons -- */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.6rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 1rem;
		font-family: inherit;
		border: 2px solid transparent;
		cursor: pointer;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
	}
	.btn:hover { text-decoration: none; transform: translateY(-2px); }
	.btn-primary {
		background: var(--orange);
		color: #fff;
		box-shadow: 0 10px 22px -10px var(--orange);
	}
	.btn-primary:hover { box-shadow: 0 16px 26px -10px var(--orange); }
	.btn-secondary {
		background: var(--blue-bright);
		color: #fff;
		box-shadow: 0 10px 22px -10px var(--blue-bright);
	}
	html[data-theme='night'] .btn-primary,
	html[data-theme='night'] .btn-secondary { color: #0C182A; }
	.btn-ghost {
		background: var(--card);
		color: var(--text-bright);
		border-color: var(--border-bright);
	}
	.btn-ghost:hover { border-color: var(--blue); color: var(--blue); }

	/* ------------------------------------------------------------ nav --- */
	nav {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.7rem 1.5rem;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.nav-logo {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--text-bright);
		letter-spacing: -0.02em;
		margin-right: auto;
	}
	.nav-logo:hover { text-decoration: none; }
	.nav-logo svg { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
	.nav-logo:hover svg { transform: translateY(-3px) rotate(-8deg); }
	.nav-links { display: flex; align-items: center; gap: 1.4rem; }
	.nav-links a { color: var(--text); font-weight: 500; font-size: 0.95rem; }
	.nav-links a:hover { color: var(--blue); text-decoration: none; }
	.nav-links .btn { padding: 0.5rem 1.1rem; font-size: 0.9rem; }
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--text);
		cursor: pointer;
		padding: 0;
	}
	.icon-btn:hover { color: var(--blue); border-color: var(--blue); }
	.theme-icon-sun { display: none; }
	html[data-theme='night'] .theme-icon-sun { display: block; }
	html[data-theme='night'] .theme-icon-moon { display: none; }

	.nav-toggle { display: none; }

	@media (max-width: 820px) {
		.nav-toggle { display: inline-flex; }
		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.4rem;
			padding: 1rem 1.5rem 1.5rem;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
		}
		.nav-links.open { display: flex; }
		.nav-links .btn { justify-content: center; }
	}

	/* --------------------------------------------------------- footer --- */
	footer {
		border-top: 1px solid var(--border);
		padding: 2.5rem 1.5rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
		background: var(--card-alt);
	}
	footer .footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		color: var(--text-bright);
		margin-bottom: 0.75rem;
	}
	footer .footer-links { display: flex; flex-wrap: wrap; gap: 1.25rem; justify-content: center; margin-bottom: 0.75rem; }

	/* ------------------------------------------------------- animation -- */
	.reveal {
		opacity: 0;
		transform: translateY(26px);
		transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.reveal.in { opacity: 1; transform: none; }

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>

<script>
	// Scroll reveals. One observer, no library; elements are visible by default
	// under prefers-reduced-motion (the CSS above wins).
	const items = document.querySelectorAll('.reveal')
	if ('IntersectionObserver' in window && items.length) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						e.target.classList.add('in')
						io.unobserve(e.target)
					}
				}
			},
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
		)
		items.forEach((el) => io.observe(el))
	} else {
		items.forEach((el) => el.classList.add('in'))
	}
</script>
