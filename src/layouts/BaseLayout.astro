---
import { Font } from 'astro:assets'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { GITHUB_URL } from '../data/site'

interface Props {
	title: string
	description: string
	ogImage?: string
	ogType?: 'website' | 'article'
	/** Extra JSON-LD to emit alongside the site-wide graph. */
	jsonLd?: Record<string, unknown>
	/** Keep the page out of search results (placeholders). */
	noindex?: boolean
}

const {
	title,
	description,
	ogImage = '/og-image.png',
	ogType = 'website',
	jsonLd,
	noindex = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(ogImage, Astro.site)
const siteURL = Astro.site?.toString() ?? 'https://rocketflare.dev/'

// One software-application entity for the whole site: this is what a search
// engine (and an AI answer engine) reads to know what Rocketflare actually is.
const softwareLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Rocketflare',
	alternateName: 'Rocketflare SaaS starter kit',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Cloudflare Workers, Node.js 24',
	url: siteURL,
	codeRepository: GITHUB_URL,
	license: 'https://opensource.org/licenses/MIT',
	description:
		'A ready-made web app you copy and make your own: sign-in, teams and permissions, an AI assistant that reads your documents, dashboards and background jobs — one Cloudflare Worker over Postgres, MIT licensed, with a one-command first run.',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	keywords:
		'B2B SaaS Cloudflare, SaaS app Cloudflare Workers, agentic SaaS, multi-tenant SaaS starter kit, Cloudflare Workers boilerplate, Hono, Drizzle, Postgres, AI agents',
}
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	<link rel="manifest" href="/site.webmanifest" />
	<link rel="canonical" href={canonicalURL} />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="llms-txt" href="/llms.txt" />
	<!-- The browser chrome colour follows the OS scheme; the page itself follows
	     the persisted data-theme choice (see the boot script below). -->
	<meta name="theme-color" content="#3B82C4" />
	<meta name="theme-color" content="#0C182A" media="(prefers-color-scheme: dark)" />
	<title>{title}</title>
	<meta name="description" content={description} />

	<meta property="og:type" content={ogType} />
	<meta property="og:site_name" content="Rocketflare" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:image" content={ogImageURL} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Rocketflare — a multi-tenant SaaS starter kit for Cloudflare Workers" />
	<meta property="og:locale" content="en_GB" />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageURL} />

	<meta name="author" content="Rocketflare" />
	<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />
	{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

	<!-- Self-hosted by the Fonts API (astro.config.mjs); only the body face is
	     preloaded — the mono face is below the fold on every page. -->
	<Font cssVariable="--font-outfit" preload />
	<Font cssVariable="--font-mono" />

	<!-- Theme boot before first paint, so there is no flash. Day is the default;
	     only an explicit saved choice or an OS dark preference switches it.
	     `html.js` is the progressive-enhancement hook: anything that only makes
	     sense with a script (the copy button, tab strips) is shown by it. -->
	<script is:inline>
		(function () {
			document.documentElement.classList.add('js')
			try {
				var saved = localStorage.getItem('theme')
				var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day')
				document.documentElement.setAttribute('data-theme', theme)
			} catch (e) {
				document.documentElement.setAttribute('data-theme', 'day')
			}
		})()
	</script>
</head>
<body>
	<a href="#main" class="skip-link">Skip to content</a>
	<Nav />
	<main id="main">
		<slot />
	</main>
	<Footer />
</body>
</html>

<style is:global>
	/* ==================================================================== *
	 * Rocketflare — token-first design system.
	 *
	 * EVERY colour on this site is a token below and is referenced with
	 * var(), including inside the inline SVG illustrations (an SVG
	 * presentation attribute resolves custom properties, so the clouds and
	 * the sky re-theme themselves). Never write a raw hex in a page; add a
	 * token here instead. The one deliberate exception is the logo mark
	 * itself (components/LogoMark.astro), whose brand fills are fixed.
	 *
	 * The palette IS the logo: sky blue, cloud cyan, sun yellow, flare
	 * orange, rocket red, cream. Day is the default; Night is the same
	 * illustration after dark. Both themes declare every token — a token
	 * missing from one of them is a bug, not a fallback.
	 * ==================================================================== */
	:root,
	html[data-theme='day'] {
		/* Brand */
		--blue: #2E6FB0;
		--blue-bright: #3B82C4;
		--cyan: #4FB3D4;
		--cyan-soft: #91D4E8;
		--yellow: #E0A81C;
		--yellow-bright: #F2C94C;
		--orange: #E8872F;
		--red: #E65A3A;
		--purple: #7C5CD6;
		--green: #2E9E6B;

		/* Sky — the page background gradient */
		--sky-top: #CFEAF7;
		--sky-mid: #E6F4FB;
		--sky-bottom: #FFF8EC;
		--cloud: #FFFFFF;
		--cloud-soft: #EAF5FC;
		--cloud-shade: #D6EAF6;

		/* Surfaces + text */
		--bg: #F2FAFE;
		--card: #FFFFFF;
		--card-alt: #F6FBFE;
		--code-bg: #10243A;
		--code-text: #D7E6F5;
		--border: #D3E6F2;
		--border-bright: #B4D6E9;
		--text: #24425C;
		--text-muted: #52708A;
		--text-bright: #10243A;
		--shadow: 24px 30px -18px rgba(16, 36, 58, 0.22);
		--shadow-sm: 0 4px 14px -6px rgba(16, 36, 58, 0.2);

		/* Tints — a wash of an accent behind an icon chip */
		--tint-blue: #E3F0FB;
		--tint-cyan: #DEF3FA;
		--tint-yellow: #FCF1D4;
		--tint-orange: #FCEBDA;
		--tint-red: #FBE3DD;
		--tint-purple: #ECE6FB;
		--tint-green: #DDF2E8;

		--sun: #F7D257;
		--star: transparent;

		/* Text on a solid accent (blue buttons, numbered steps) */
		--on-accent: #FFFFFF;
		/* Text on the brand orange: white fails contrast on it by day (2.6:1), so
		   an orange button carries the dark ink instead (6:1) */
		--on-orange: #10243A;
		/* An accent used as TEXT on a light surface: mixed toward the ink until it
		   reads (the bright brand values are ~2.5–4:1 on the day backgrounds).
		   `--accent-ink` (per tone, below) and `--orange-ink` derive from this. */
		--ink-mix: 55%;
		--orange-ink: color-mix(in srgb, var(--orange) var(--ink-mix), var(--text-bright));
		/* A drop-shadow() colour — filters cannot take a box-shadow token */
		--shadow-ink: rgba(16, 36, 58, 0.25);

		/* Browser chrome around a screenshot */
		--frame: #E4EEF6;
		--frame-dots: #B4C8D8;

		/* Terminal */
		--terminal-bg: #10243A;
		--terminal-text: #D7E6F5;
		--terminal-prompt: #4FB3D4;
		--terminal-ok: #6FD6A5;

		/* Chat bubbles: the person is orange, the agent is blue */
		--bubble-user: #FCEBDA;
		--bubble-agent: #E3F0FB;

		/* A dark band section: the code palette by day, lifted a step by night */
		--band-bg: #10243A;
		--band-ink: #D7E6F5;
		--band-muted: #8FA9C2;

		/* Fluid type steps — the h1/h2 sizes below are these, so rhythm is shared */
		--step-1: clamp(1.05rem, 1.7vw, 1.28rem);
		--step-2: clamp(1.25rem, 0.8rem + 1.4vw, 1.6rem);
		--step-3: clamp(1.8rem, 4vw, 2.75rem);
		--step-4: clamp(2.4rem, 6.5vw, 4.4rem);

		/* The Fonts API (astro.config.mjs) defines --font-outfit / --font-mono
		   with their fallback stacks; these are the names the site uses. */
		--mono: var(--font-mono), 'JetBrains Mono', ui-monospace, monospace;
		--sans: var(--font-outfit), 'Outfit', ui-sans-serif, system-ui, -apple-system, sans-serif;

		color-scheme: light;
	}

	html[data-theme='night'] {
		--blue: #6FB2E8;
		--blue-bright: #8CC6F2;
		--cyan: #7FD6EE;
		--cyan-soft: #A9E4F5;
		--yellow: #F5D371;
		--yellow-bright: #FCE39A;
		--orange: #F5A45C;
		--red: #F58367;
		--purple: #B39BF5;
		--green: #6FD6A5;

		--sky-top: #0A1526;
		--sky-mid: #12233C;
		--sky-bottom: #1D2E45;
		--cloud: #26405E;
		--cloud-soft: #1B3049;
		--cloud-shade: #16283E;

		--bg: #0C182A;
		--card: #16273D;
		--card-alt: #1B2E48;
		--code-bg: #0A1524;
		--code-text: #C7DCF0;
		--border: #24405F;
		--border-bright: #35597F;
		--text: #C4D8EC;
		--text-muted: #8AA5C0;
		--text-bright: #EFF6FD;
		--shadow: 24px 30px -18px rgba(0, 0, 0, 0.55);
		--shadow-sm: 0 4px 14px -6px rgba(0, 0, 0, 0.5);

		--tint-blue: #1B3454;
		--tint-cyan: #17354A;
		--tint-yellow: #3A3016;
		--tint-orange: #3B2A16;
		--tint-red: #3B211A;
		--tint-purple: #2A2350;
		--tint-green: #143528;

		--sun: #F5D371;
		--star: #DCEBFA;

		--on-accent: #0C182A;
		--on-orange: #0C182A;
		/* By night the accents are already light on dark: no mixing */
		--ink-mix: 100%;
		--orange-ink: var(--orange);
		--shadow-ink: rgba(0, 0, 0, 0.55);

		--frame: #1F3450;
		--frame-dots: #4A6A8C;

		--terminal-bg: #081120;
		--terminal-text: #C7DCF0;
		--terminal-prompt: #7FD6EE;
		--terminal-ok: #6FD6A5;

		--bubble-user: #3B2A16;
		--bubble-agent: #1B3454;

		--band-bg: #16273D;
		--band-ink: #DCEBFA;
		--band-muted: #8AA5C0;

		color-scheme: dark;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html { scroll-behavior: smooth; scroll-padding-top: 5rem; }

	body {
		margin: 0;
		font-family: var(--sans);
		color: var(--text);
		background: var(--bg);
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	h1, h2, h3, h4 {
		color: var(--text-bright);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 0.6em;
	}
	h1 { font-size: var(--step-4); font-weight: 800; }
	h2 { font-size: var(--step-3); font-weight: 700; }
	h3 { font-size: 1.2rem; font-weight: 600; }
	p { margin: 0 0 1rem; }

	a { color: var(--blue); text-decoration: none; }
	a:hover { text-decoration: underline; }
	/* A link inside running text is told apart by more than its colour (the
	   blue is ~1.5:1 against the body ink). Buttons, tiles (`li > a`) and the
	   nav/footer/sidebars (not in a p/li) stay clean. */
	:is(p, li, td, dd, figcaption) a:not(.btn, li > a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
		text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
	}
	:is(p, li, td, dd, figcaption) a:not(.btn):hover { text-decoration-color: currentColor; }

	code {
		font-family: var(--mono);
		font-variant-ligatures: none;
		font-size: 0.875em;
		background: var(--tint-blue);
		color: var(--text-bright);
		padding: 0.12em 0.4em;
		border-radius: 5px;
	}
	pre {
		font-family: var(--mono);
		font-variant-ligatures: none;
		background: var(--code-bg);
		color: var(--code-text);
		padding: 1.25rem 1.4rem;
		border-radius: 14px;
		overflow-x: auto;
		font-size: 0.85rem;
		line-height: 1.75;
		margin: 0;
	}
	pre code { background: none; color: inherit; padding: 0; font-size: inherit; }

	:focus-visible {
		outline: 3px solid var(--orange);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* The skip link: off-screen until it takes focus, then a pill over the nav. */
	.skip-link {
		position: absolute;
		top: 0.6rem;
		left: 0.6rem;
		z-index: 100;
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: var(--orange);
		color: var(--on-orange);
		font-weight: 600;
		transform: translateY(-200%);
		transition: transform 0.15s ease;
	}
	.skip-link:focus-visible { transform: none; text-decoration: none; }

	/* ---------------------------------------------------------- layout -- */
	.wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
	/* Same outer edge as .wrap (every page lines up); the content inside stays a readable width. */
	.wrap-narrow { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
	.wrap-narrow > * { max-width: 860px; }

	section { position: relative; }

	.eyebrow {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--orange-ink);
		margin-bottom: 0.9rem;
	}
	.section-head { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
	.section-head p { color: var(--text-muted); font-size: 1.08rem; }
	.measure { max-width: 62ch; }

	/* ------------------------------------------------------- page hero --
	   One shape for the heading block of every page except the landing
	   page (whose hero carries the sky scene and keeps the --step-4 h1):
	   the .wrap edge, one copy width, one type scale. A page adds a
	   background and nothing else — never its own width or h1 size. */
	.page-hero { padding: 3.6rem 0 4rem; }
	.page-hero .hero-copy { max-width: 900px; }
	.page-hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin-bottom: 0.4em; }
	.page-hero .lede { font-size: var(--step-1); color: var(--text-muted); max-width: 62ch; margin: 0; }

	/* Section backgrounds. */
	.bg-sky { background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 48%, var(--sky-bottom) 100%); }
	.bg-band { background: var(--band-bg); color: var(--band-ink); }
	.bg-band h1, .bg-band h2, .bg-band h3, .bg-band h4 { color: var(--band-ink); }
	.bg-band .text-muted, .bg-band .section-head p { color: var(--band-muted); }
	.bg-band a:not(.btn) { color: var(--cyan); }
	.bg-band .eyebrow { color: var(--orange); } /* the mixed ink is for light surfaces */
	.bg-lift {
		background:
			radial-gradient(900px 380px at 50% 0%, var(--tint-orange), transparent 70%),
			var(--card);
	}

	/* Tones: a section, card or tag picks an accent and its tint with one class.
	   Defined once here; components read --accent / --tint, and --accent-ink
	   when the accent is small TEXT on a light surface (eyebrows, the current
	   sidebar link, a "why" lead-in) — the raw accent is for fills and borders. */
	.tone-blue   { --accent: var(--blue-bright); --tint: var(--tint-blue); }
	.tone-purple { --accent: var(--purple);      --tint: var(--tint-purple); }
	.tone-orange { --accent: var(--orange);      --tint: var(--tint-orange); }
	.tone-cyan   { --accent: var(--cyan);        --tint: var(--tint-cyan); }
	.tone-red    { --accent: var(--red);         --tint: var(--tint-red); }
	.tone-green  { --accent: var(--green);       --tint: var(--tint-green); }
	.tone-yellow { --accent: var(--yellow);      --tint: var(--tint-yellow); }
	[class*='tone-'] { --accent-ink: color-mix(in srgb, var(--accent) var(--ink-mix), var(--text-bright)); }
	/* Yellow is the lightest brand value, so the shared 55% leaves --accent-ink at
	   4.47:1 on --tint-yellow — below AA for the bold lead-in of a `.why` block.
	   More ink for this one tone by day (5.6:1); by night --ink-mix is 100% and
	   the accent already reads on dark, so the override must not apply there. */
	html[data-theme='day'] [class*='tone-yellow'] { --ink-mix: 45%; }

	/* ---------------------------------------------------------- buttons -- */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.6rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 1rem;
		font-family: inherit;
		border: 2px solid transparent;
		cursor: pointer;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
	}
	.btn:hover { text-decoration: none; transform: translateY(-2px); }
	.btn-primary {
		background: var(--orange);
		color: var(--on-orange);
		box-shadow: 0 10px 22px -10px var(--orange);
	}
	.btn-primary:hover { box-shadow: 0 16px 26px -10px var(--orange); }
	.btn-secondary {
		/* --blue, not --blue-bright: white on the bright blue is 4.05:1 by day */
		background: var(--blue);
		color: var(--on-accent);
		box-shadow: 0 10px 22px -10px var(--blue);
	}
	.btn-ghost {
		background: var(--card);
		color: var(--text-bright);
		border-color: var(--border-bright);
	}
	.btn-ghost:hover { border-color: var(--blue); color: var(--blue); }

	/* ------------------------------------------------------------ nav --- */
	nav.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.7rem 1.5rem;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.nav-logo {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--text-bright);
		letter-spacing: -0.02em;
		margin-right: auto;
	}
	.nav-logo:hover { text-decoration: none; }
	.nav-logo svg { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
	.nav-logo:hover svg { transform: translateY(-3px) rotate(-8deg); }
	.nav-links { display: flex; align-items: center; gap: 1.4rem; }
	.nav-links a { color: var(--text); font-weight: 500; font-size: 0.95rem; }
	.nav-links a:hover { color: var(--blue); text-decoration: none; }
	.nav-links .btn { padding: 0.5rem 1.1rem; font-size: 0.9rem; }
	/* `.nav-links a` outranks `.btn-primary`; say the ink again so the pill matches the hero's. */
	.nav-links .btn-primary, .nav-links .btn-primary:hover { color: var(--on-orange); }
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--text);
		cursor: pointer;
		padding: 0;
	}
	.icon-btn:hover { color: var(--blue); border-color: var(--blue); }
	.theme-icon-sun { display: none; }
	html[data-theme='night'] .theme-icon-sun { display: block; }
	html[data-theme='night'] .theme-icon-moon { display: none; }

	.nav-toggle { display: none; }

	@media (max-width: 820px) {
		.nav-toggle { display: inline-flex; }
		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.4rem;
			padding: 1rem 1.5rem 1.5rem;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
		}
		.nav-links.open { display: flex; }
		.nav-links .btn { justify-content: center; }
	}

	/* --------------------------------------------------------- footer --- */
	footer {
		border-top: 1px solid var(--border);
		padding: 2.5rem 1.5rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
		background: var(--card-alt);
	}
	footer .footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		color: var(--text-bright);
		margin-bottom: 0.75rem;
	}
	footer .footer-links { display: flex; flex-wrap: wrap; gap: 1.25rem; justify-content: center; margin-bottom: 0.75rem; }

	/* ------------------------------------------------------- animation -- */
	/* Hidden only once html.js exists (the observer below is what shows it
	   again); a reader without scripts sees every block. */
	html.js .reveal {
		opacity: 0;
		transform: translateY(26px);
		transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	html.js .reveal.in { opacity: 1; transform: none; }
	/* A list that reveals its children one after another: the wrapper carries .reveal too (the
	   observer watches it) and the children slide in behind it. Hidden only once html.js exists,
	   so a reader without scripts sees every item. */
	html.js .reveal-stagger > * {
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}
	html.js .reveal.reveal-stagger { transform: none; }
	html.js .reveal-stagger.in > * { opacity: 1; transform: none; }
	.reveal-stagger > :nth-child(2) { transition-delay: 0.07s; }
	.reveal-stagger > :nth-child(3) { transition-delay: 0.14s; }
	.reveal-stagger > :nth-child(4) { transition-delay: 0.21s; }
	.reveal-stagger > :nth-child(5) { transition-delay: 0.28s; }
	.reveal-stagger > :nth-child(6) { transition-delay: 0.35s; }
	.reveal-stagger > :nth-child(7) { transition-delay: 0.42s; }
	.reveal-stagger > :nth-child(8) { transition-delay: 0.49s; }

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
		.reveal-stagger > * { opacity: 1 !important; transform: none !important; transition: none !important; }
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}
