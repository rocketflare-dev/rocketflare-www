{
	"name": "rocketflare-www",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && npm run typecheck:worker && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"deploy": "npm run build && wrangler deploy",
		"typecheck:worker": "tsc -p worker/tsconfig.json",
		"types": "wrangler types",
		"sync:releases": "node scripts/sync-releases.mjs",
		"check:releases": "node scripts/sync-releases.mjs --check"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.2",
		"astro": "^6.1.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"typescript": "^5.9.3",
		"wrangler": "^4.95.0"
	}
}
